    shacl:class <https://w3id.org/GConsent#Consent>;
    shacl:description "Refering to the possibility for a data controller to withdraw the consent"@en;
    shacl:name "can withdraw consent"@en;
    shacl:path <https://purl.eu/ns/consent#DataController.canWithdrawConsent>
  ];
  shacl:targetClass <https://w3id.org/GConsent#DataController> .

<https://purl.eu/doc/applicationprofile/consent/kandidaatstandaard/2022-02-23#DataProcessorShape> a shacl:NodeShape;
  shacl:closed false;
  shacl:property [
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/kandidaatstandaard/2022-02-23#DataProcessor.LegalName>;
    shacl:datatype rdf:langString;
    shacl:description "The legal name under which the Data Processor is registered."@en;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "legal name"@en;
    shacl:path <https://purl.eu/ns/consent#DataProcessor.legalName>
  ], [
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/kandidaatstandaard/2022-02-23#DataProcessor.Identifier>;
    shacl:class <http://todo.com/Identifier>;
    shacl:description "Unique method to prove the identify of the Data Processor."@en;
    shacl:minCount "1";
    shacl:name "identifier"@en;
    shacl:path <https://purl.eu/ns/consent#DataProcessor.identifier>
  ];
  shacl:targetClass <https://dpvcg.github.io/dpv/#DataProcessor> .

<https://purl.eu/doc/applicationprofile/consent/kandidaatstandaard/2022-02-23#DataRetentionShape> a shacl:NodeShape;
  shacl:closed false;
  shacl:property [
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/kandidaatstandaard/2022-02-23#DataRetention.LiveData>;
    shacl:datatype xsd:boolean;
    shacl:description "Stating if the data should be a snapshot (i.e., not live data) or if the consent requires access to the latest version of the data (i.e., live data)"@en;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "live data"@en;
    shacl:path <https://purl.eu/ns/consent#DataRetention.liveData>
  ], [
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/kandidaatstandaard/2022-02-23#DataRetention.ExpiryDate>;
    shacl:datatype xsd:dateTime;
    shacl:description "The date on which the data retention stops"@en;
    shacl:maxCount "1";
    shacl:name "expiry date"@en;
    shacl:path <https://purl.eu/ns/consent#DataRetention.expiryDate>
  ], [
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/kandidaatstandaard/2022-02-23#DataRetention.StartDate>;
    shacl:datatype xsd:dateTime;
    shacl:description "The moment in time when the data retention starts"@en;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "start date"@en;
    shacl:path <https://purl.eu/ns/consent#DataRetention.startDate>
  ], [
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/kandidaatstandaard/2022-02-23#DataRetention.LegalBasis>;
    shacl:class <https://dpvcg.github.io/dpv/#LegalBasis>;
    shacl:description "The legal basis that substantiates the data retention"@en;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "legal basis"@en;
    shacl:path <https://purl.eu/ns/consent#DataRetention.legalBasis>
  ], [
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/kandidaatstandaard/2022-02-23#DataRetention.ExpiryTime>;
    shacl:class <http://data.europa.eu/m8g/PeriodOfTime>;
    shacl:description "The duration of the data retention, starting from the start date"@en;
    shacl:maxCount "1";
    shacl:name "expiry time"@en;
    shacl:path <https://purl.eu/ns/consent#DataRetention.expiryTime>
  ], [
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/kandidaatstandaard/2022-02-23#DataRetention.DataRetentionPolicyDocument>;
    shacl:class <http://xmlns.com/foaf/spec/#term_Document>;
    shacl:description "An human readable document is provided explaining what are the data retention requirements related to the consent."@en;
    shacl:name "data retention policy document"@en;
    shacl:path <https://purl.eu/ns/consent#DataRetention.inHumanReadableForm>
  ], [
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/kandidaatstandaard/2022-02-23#DataRetention.Processing>;
    shacl:class <http://todo.com/ProcessingType>;
    shacl:description "Processing specifies what is happening to/with the data."@en;
    shacl:name "processing"@en;
    shacl:path <https://dpvcg.github.io/dpv/#Processing>
  ];
  shacl:targetClass <https://purl.eu/ns/consent#DataRetention> .

<https://purl.eu/doc/applicationprofile/consent/kandidaatstandaard/2022-02-23#DataSubjectShape> a shacl:NodeShape;
  shacl:closed false;
  shacl:property [
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/kandidaatstandaard/2022-02-23#DataSubject.HasConsent>;
