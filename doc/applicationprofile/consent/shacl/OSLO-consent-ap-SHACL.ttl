  shacl:targetClass <https://purl.eu/dc/terms/Agent> .

<https://purl.eu/doc/applicationprofile/consent/kandidaatstandaard/2022-02-23#BooleanShape> a shacl:NodeShape;
  shacl:closed false;
  shacl:targetClass xsd:boolean .

<https://purl.eu/doc/applicationprofile/consent/kandidaatstandaard/2022-02-23#ConsentShape> a shacl:NodeShape;
  shacl:closed false;
  shacl:property [
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/kandidaatstandaard/2022-02-23#Consent.CreationTime>;
    shacl:datatype xsd:dateTime;
    shacl:description "The moment in time in which this specific version of the consent was created"@en;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "creation time"@en;
    shacl:path <https://w3id.org/GConsent#atTime>
  ], [
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/kandidaatstandaard/2022-02-23#Consent.Notice>;
    shacl:datatype rdf:langString;
    shacl:description "Additional note added to the consent"@en;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "notice"@en;
    shacl:path <https://purl.eu/ns/consent#Consent.notice>
  ], [
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/kandidaatstandaard/2022-02-23#Consent.Status>;
    shacl:class <https://purl.eu/ns/consent#ConsentStatus>;
    shacl:description "Represents the status of consent for the data subject."@en;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "status"@en;
    shacl:path <https://w3id.org/GConsent#hasStatus>
  ], [
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/kandidaatstandaard/2022-02-23#Consent.Medium>;
    shacl:class <https://w3id.org/GConsent#Medium>;
    shacl:description "The way this specific version of the consent was created"@en;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "medium"@en;
    shacl:path <https://w3id.org/GConsent#inMedium>
  ], [
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/kandidaatstandaard/2022-02-23#Consent.ConsentDocument>;
    shacl:class <http://xmlns.com/foaf/spec/#term_Document>;
    shacl:description "An human readable document is provided of the consent."@en;
    shacl:name "consent document"@en;
    shacl:path <https://purl.eu/ns/consent#Consent.inHumanReadableForm>
  ], [
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/kandidaatstandaard/2022-02-23#Consent.IsInvalidatedBy>;
    shacl:class <https://w3id.org/GConsent#Consent>;
    shacl:description "A previous version of the consent is invalidated by a newer version of the consent"@en;
    shacl:maxCount "1";
    shacl:name "is invalidated by"@en;
    shacl:path <https://purl.eu/ns/consent#Consent.isInvalidatedBy>
  ], [
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/kandidaatstandaard/2022-02-23#Consent.Invalidates>;
    shacl:class <https://w3id.org/GConsent#Consent>;
    shacl:description "A newer version of a consent invalidates a previous version of the consent"@en;
    shacl:name "invalidates"@en;
    shacl:path <https://purl.eu/ns/consent#Consent.invalidates>
  ], [
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/kandidaatstandaard/2022-02-23#Consent.IsConsentForDataSubject>;
    shacl:class <https://w3id.org/GConsent#DataSubject>;
    shacl:description "Links a consent instance with the data subject it is associated with."@en;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "is consent for data subject"@en;
    shacl:path <https://w3id.org/GConsent#isConsentForDataSubject>
  ], [
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/kandidaatstandaard/2022-02-23#Consent.IsContingentOn>;
    shacl:class <http://data.europa.eu/m8g/#Criterion>;
    shacl:description "Indicates that the consent is depending on one or more criteria."@en;
    shacl:name "is contingent on"@en;
    shacl:path <http://todo.com/isContingentOn>
  ], [
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/kandidaatstandaard/2022-02-23#Consent.IsProvidedByDelegation>;
    shacl:class <https://w3id.org/GConsent#Delegation>;
    shacl:description "Specifies the delegation that provided this consent."@en;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "is provided by delegation"@en;
    shacl:path <https://w3id.org/GConsent#isProvidedByDelegation>
  ], [
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/kandidaatstandaard/2022-02-23#Consent.IsProvidedTo>;
    shacl:class <https://w3id.org/GConsent#Delegation>;
    shacl:description "Indicates the Person or Data Controller the consent was provided to."@en;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "is provided to"@en;
    shacl:path <https://w3id.org/GConsent#isProvidedTo>
  ], [
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/kandidaatstandaard/2022-02-23#Consent.IsUpdatedConsentFor>;
    shacl:class <https://w3id.org/GConsent#Consent>;
    shacl:description "Specifies the consent instance which this instance is an update or revision of."@en;
    shacl:maxCount "1";
    shacl:name "is updated consent for"@en;
    shacl:path <https://w3id.org/GConsent#isUpdatedConsentFor>
  ], [
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/kandidaatstandaard/2022-02-23#Consent.IsPreviousConsentFor>;
    shacl:class <https://w3id.org/GConsent#Consent>;
    shacl:description "Denotes that this consent instance is the previous consent for the specified consent instance."@en;
    shacl:maxCount "1";
    shacl:name "is previous consent for"@en;
    shacl:path <https://w3id.org/GConsent#isPreviousConsentFor>
  ], [
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/kandidaatstandaard/2022-02-23#Consent.ForPersonalData>;
    shacl:class <https://w3id.org/GConsent#PersonalData>;
    shacl:description "The personal data for which the consent was given"@en;
    shacl:name "for personal data"@en;
    shacl:path <https://w3id.org/GConsent#forPersonalData>
  ], [
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/kandidaatstandaard/2022-02-23#Consent.IsProvidedToController>;
    shacl:class <https://w3id.org/GConsent#DataController>;
    shacl:description "The consent that is provided to the data controller"@en;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "is provided to controller"@en;
    shacl:path <https://w3id.org/GConsent#isProvidedToController>
  ], [
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/kandidaatstandaard/2022-02-23#Consent.IsProvidedByDataSubject>;
    shacl:class <https://w3id.org/GConsent#DataSubject>;
    shacl:description "Indicates that the consent is given by the data subject."@en;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "is provided by data subject"@en;
    shacl:path <https://w3id.org/GConsent#isProvidedByDataSubject>
  ], [
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/kandidaatstandaard/2022-02-23#Consent.Oslo::isGivenFor>;
    shacl:class <https://dpvcg.github.io/dpv/#PersonalDataHandling>;
    shacl:description "The consent that is given for the personal data handling"@en;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "oSLO: :is given for"@en;
    shacl:path <http://todo.com/oSLO::IsGivenFor>
  ];
  shacl:targetClass <https://w3id.org/GConsent#Consent> .

<https://purl.eu/doc/applicationprofile/consent/kandidaatstandaard/2022-02-23#ConsentStatusShape> a shacl:NodeShape;
