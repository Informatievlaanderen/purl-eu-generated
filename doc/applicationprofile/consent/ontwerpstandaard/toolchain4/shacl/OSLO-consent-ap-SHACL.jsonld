  {
    "@id": "https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#DatacontrollerShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "en",
        "@value": "The terms 'Controller' is usually the more common form of indicating a DataController. In <a href=\"https://www.iso.org/standard/80392.html\">ISO/IEC</a> the term 'PII Controller' is used."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The individual or organisation that decides (or controls) the purpose(s) of processing the PersonalData."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "DataController"
      }
    ],
    "http://www.w3.org/ns/shacl#closed": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#boolean",
        "@value": "false"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "https://w3id.org/dpv/dpv-owl#DataController"
      }
    ]
  },
  {
    "@id": "https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#DataprocessorShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A 'processor' means a natural or legal person, public authority, agency or other body which processes personal data on behalf of the DataController."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "DataProcessor"
      }
    ],
    "http://www.w3.org/ns/shacl#closed": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#boolean",
        "@value": "false"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "https://w3id.org/dpv/dpv-owl#DataProcessor"
      }
    ]
  },
  {
    "@id": "https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#DatasubjectShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "en",
        "@value": "The term 'data subject' is specific to the GDPR, but is functionally equivalent to the term 'individual' and the <a href=\"https://www.iso.org/standard/80392.html\">ISO/IEC</a> term 'PII Principle'. REMARK: Can also be instantiated as a category, eg PersonalDataHandling123 for DataSubject(s) of type Customer."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The individual (or category of individuals) whose PersonalData is being processed."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "DataSubject"
      }
    ],
    "http://www.w3.org/ns/shacl#closed": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#boolean",
        "@value": "false"
      }
    ],
    "http://www.w3.org/ns/shacl#property": [
      {
        "@id": "_:df_8_23"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "https://w3id.org/dpv/dpv-owl#DataSubject"
      }
    ]
  },
