      {
        "@language": "en",
        "@value": "Eg for a state equal to GivenConsent if the Consent was given in an analogue or electronic way and if electronic for example by DigitalTickbox or DigitalSignature or other."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
