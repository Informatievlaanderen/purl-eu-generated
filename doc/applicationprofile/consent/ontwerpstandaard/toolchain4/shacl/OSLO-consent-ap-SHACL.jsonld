      {
        "@id": "https://w3id.org/dpv/dpv-owl#ConsentNotice"
      }
    ]
  },
  {
    "@id": "https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#ConsentShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "en",
        "@value": "REMARK: The name of this class does not imply that Consent has been given or is valid. This  depends on the value of attributes like hasConsentStatus and others."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Consent of the DataSubject for the specified Processing of their PersonalData."
