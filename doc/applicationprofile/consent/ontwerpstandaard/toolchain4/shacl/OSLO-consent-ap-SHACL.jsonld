      {
        "@language": "en",
        "@value": "To be used as an abstract superclass and to be substituted by an Agent like a Person or Organisation and/or a LegalEntity like a DataSubject, DataController etc."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A human or non-human 'thing' that constitutes as an entity."
