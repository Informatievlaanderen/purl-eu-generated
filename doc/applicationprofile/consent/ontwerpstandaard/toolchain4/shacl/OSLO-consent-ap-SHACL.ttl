@prefix dc: <http://purl.org/dc/terms/> .
@prefix dc11: <http://purl.org/dc/elements/1.1/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix shacl: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#> rdfs:member <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#DataprocessorShape>,
    <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#ConsentnoticeShape>,
    <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#LegalbasisShape>,
    <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#PersonaldataShape>,
    <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#LegalentityShape>,
    <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#EntityShape>,
    <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#RiskShape>,
    <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#RightShape>,
    <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#PurposetypeShape>,
    <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#DatacontrollerShape>,
    <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#DatasubjecttypeShape>,
    <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#PurposeShape>,
    <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#ConsentstatusShape>,
    <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#RecipientShape>,
    <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#ProcessingtypeShape>,
    <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#ProcessingShape>,
    <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#PersonaldatatypeShape>,
    <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#TechnicalmeasureShape>,
    <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#PersonaldatahandlingShape>,
    <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#StoragedurationShape>,
    <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#StorageconditionShape>,
    <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#ConsentShape>,
    <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#DatasubjectShape>,
    <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#OrganisationalmeasureShape>,
    <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#AgentShape>,
    <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#RegisteredPersonShape>,
    <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#RegisteredorganisationShape>,
    <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#IndicationmethodtypeShape>,
    <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#DurationtypeShape>,
    <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#LivedatatypeShape>,
    <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#PersonShape>,
    <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#OrganisationShape>,
    <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#IdentifierShape>,
    <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#DatetimeShape>,
    <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#StringShape>,
    <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#LiteralShape>,
    <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#LangstringShape>,
    <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#DurationShape>,
    <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#LocationShape> .

<https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#AgentShape> a shacl:NodeShape;
  rdfs:label "Agent"@en;
  rdfs:comment "A resource that acts or has the power to act."@en;
  shacl:closed false;
  shacl:targetClass dc:Agent .

<https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#ConsentShape> a shacl:NodeShape;
  rdfs:label "Consent"@en;
  <http://purl.org/vocab/vann/usageNote> "REMARK: The name of this class does not imply that Consent has been given or is valid. This  depends on the value of attributes like hasConsentStatus and others."@en;
  rdfs:comment "Consent of the DataSubject for the specified Processing of their PersonalData."@en;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "isIndicatedAtTime"@en;
    <http://purl.org/vocab/vann/usageNote> "To be updated when the ConsentStatus changes."@en;
    rdfs:comment "Moment when this stage of the Consent was created."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#Consent.Isindicatedattime>;
    shacl:datatype xsd:dateTime;
    shacl:description "Moment when this stage of the Consent was created."@en;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "isIndicatedAtTime"@en;
    shacl:path <https://w3id.org/dpv/dpv-owl#isIndicatedAtTime>
  ], [
    a shacl:PropertyShape;
    rdfs:label "hasConsentStatus"@en;
    <http://purl.org/vocab/vann/usageNote> "Examples are: ConsentRequested, ConsentGiven, ConsentWithdrawn etc."@en;
    rdfs:comment "Specifies the state or status of consent."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#Consent.Hasconsentstatus>;
    shacl:class skos:Concept;
    shacl:description "Specifies the state or status of consent."@en;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "hasConsentStatus"@en;
    shacl:path <https://w3id.org/dpv/dpv-owl#hasConsentStatus>
  ], [
    a shacl:PropertyShape;
    rdfs:label "hasDuration"@en;
    <http://purl.org/vocab/vann/usageNote> "For example to indicate how long the Consent is valid (eg 6 months), or until what time (eg 31 december 2022) or until which event (eg account closure)."@en;
    rdfs:comment "Indicates information about the Duration of the Consent."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#Consent.Hasduration>;
    shacl:class <https://w3id.org/dpv/dpv-owl#Duration>;
    shacl:description "Indicates information about the Duration of the Consent."@en;
    shacl:maxCount "1";
    shacl:name "hasDuration"@en;
    shacl:path <https://w3id.org/dpv/dpv-owl#hasDuration>
  ], [
    a shacl:PropertyShape;
    rdfs:label "hasLocation"@en;
    <http://purl.org/vocab/vann/usageNote> "To be updated when the ConsentStatus changes."@en;
    rdfs:comment "Location where this stage of the Consent was created."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#Consent.Haslocation>;
    shacl:class prov:Location;
    shacl:description "Location where this stage of the Consent was created."@en;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "hasLocation"@en;
    shacl:path <https://w3id.org/dpv/dpv-owl#hasLocation>
  ], [
    a shacl:PropertyShape;
    rdfs:label "hasNotice"@en;
    rdfs:comment "Reference to the applied or used ConsentNotice."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#Consent.Hasnotice>;
    shacl:class <https://w3id.org/dpv/dpv-owl#ConsentNotice>;
    shacl:description "Reference to the applied or used ConsentNotice."@en;
    shacl:name "hasNotice"@en;
    shacl:path <https://w3id.org/dpv/dpv-owl#hasNotice>
  ], [
    a shacl:PropertyShape;
    rdfs:label "hasIndicationMethod"@en;
    <http://purl.org/vocab/vann/usageNote> "Eg for a state equal to GivenConsent if the Consent was given in an analogue or electronic way and if electronic for example by DigitalTickbox or DigitalSignature or other."@en;
    rdfs:comment "Way in which the current state of Consent realized."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#Consent.Hasindicationmethod>;
    shacl:class skos:Concept;
    shacl:description "Way in which the current state of Consent realized."@en;
    shacl:maxCount "1";
    shacl:name "hasIndicationMethod"@en;
    shacl:path <https://w3id.org/dpv#hasIndicationMethod>
  ], [
    a shacl:PropertyShape;
    rdfs:label "isIndicatedBy"@en;
    <http://purl.org/vocab/vann/usageNote> "Eg the Dat Controller if the status is ConsentRequested or the DataSubject for a ConsentGiven. To be updated when the ConsentStatus changes. REMARK: Required in case of Consent by delegation, such as in the case of a parent or a guardian responsible for providing or affirming Consent. Can be omitted if the referenced entity is identical to the DataSubject."@en;
    rdfs:comment "Entity that is responsible for this stage of the Consent."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#Consent.Isindicatedby>;
    shacl:class <https://w3id.org/dpv/dpv-owl#Entity>;
    shacl:description "Entity that is responsible for this stage of the Consent."@en;
    shacl:maxCount "1";
    shacl:name "isIndicatedBy"@en;
    shacl:path <https://w3id.org/dpv/dpv-owl#isIndicatedBy>
  ], [
    a shacl:PropertyShape;
    rdfs:label "hasDataSubject"@en;
    rdfs:comment "Indicates the association of the Consent with a DataSubject."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#Consent.Hasdatasubject>;
    shacl:class <https://w3id.org/dpv/dpv-owl#DataSubject>;
    shacl:description "Indicates the association of the Consent with a DataSubject."@en;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "hasDataSubject"@en;
    shacl:path <https://w3id.org/dpv/dpv-owl#hasDataSubject>
  ];
  shacl:targetClass <https://w3id.org/dpv/dpv-owl#Consent> .

<https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#ConsentnoticeShape> a shacl:NodeShape;
  rdfs:label "ConsentNotice"@en;
  <http://purl.org/vocab/vann/usageNote> "This is to inform the Data Subject before his Consent can be obtained. To be substituted by a String, URL or Document referencing the actual Notice."@en;
  rdfs:comment "A Notice for information provision associated with a Consent."@en;
  shacl:closed false;
  shacl:targetClass <https://w3id.org/dpv/dpv-owl#ConsentNotice> .

<https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#ConsentstatusShape> a shacl:NodeShape;
  rdfs:label "ConsentStatus";
  shacl:closed false;
  shacl:targetClass skos:Concept .

<https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#DatacontrollerShape> a shacl:NodeShape;
  rdfs:label "DataController"@en;
  <http://purl.org/vocab/vann/usageNote> "The terms 'Controller' is usually the more common form of indicating a DataController. In <a href=\"https://www.iso.org/standard/80392.html\">ISO/IEC</a> the term 'PII Controller' is used."@en;
  rdfs:comment "The individual or organisation that decides (or controls) the purpose(s) of processing the PersonalData."@en;
  shacl:closed false;
  shacl:targetClass <https://w3id.org/dpv/dpv-owl#DataController> .

<https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#DataprocessorShape> a shacl:NodeShape;
  rdfs:label "DataProcessor"@en;
  rdfs:comment "A 'processor' means a natural or legal person, public authority, agency or other body which processes personal data on behalf of the DataController."@en;
  shacl:closed false;
  shacl:targetClass <https://w3id.org/dpv/dpv-owl#DataProcessor> .

<https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#DatasubjectShape> a shacl:NodeShape;
  rdfs:label "DataSubject"@en;
  <http://purl.org/vocab/vann/usageNote> "The term 'data subject' is specific to the GDPR, but is functionally equivalent to the term 'individual' and the <a href=\"https://www.iso.org/standard/80392.html\">ISO/IEC</a> term 'PII Principle'. REMARK: Can also be instantiated as a category, eg PersonalDataHandling123 for DataSubject(s) of type Customer."@en;
  rdfs:comment "The individual (or category of individuals) whose PersonalData is being processed."@en;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "type"@en;
    <http://purl.org/vocab/vann/usageNote> "For example age-based types like Adult, Child or domain-based ones like Patient, Employee ore jurisdictional roles like Citizen, Immigrant."@en;
    rdfs:comment "Type of DataSubject."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#Datasubject.Type>;
    shacl:class skos:Concept;
    shacl:description "Type of DataSubject."@en;
    shacl:maxCount "1";
    shacl:name "type"@en;
    shacl:path dc11:type
  ];
  shacl:targetClass <https://w3id.org/dpv/dpv-owl#DataSubject> .

<https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#DatasubjecttypeShape> a shacl:NodeShape;
  rdfs:label "DataSubjectType";
  shacl:closed false;
  shacl:targetClass skos:Concept .

<https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#DatetimeShape> a shacl:NodeShape;
  rdfs:label "DateTime";
  shacl:closed false;
  shacl:targetClass xsd:dateTime .

<https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#DurationShape> a shacl:NodeShape;
  rdfs:label "Duration"@en;
  <http://purl.org/vocab/vann/usageNote> "REMARK: The details of this class can be provided by using the <a href=\"https://www.w3.org/TR/owl-time/\">Time Ontology</a> according to the type of Duration. Eg if the type is DPV:TemporalDuration one could adda OWL-TIME:TemporalEntity as an additional type and hasXSDDuration as an attribute."@en;
  rdfs:comment "The duration or temporal limitation."@en;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "type"@en;
    <http://purl.org/vocab/vann/usageNote> "Examples are TemporalDuration (eg 6 months), UnitilTimeDuration (eg till 31 december 2022), UntilEventDuration (eg until account closure)."@en;
    rdfs:comment "Type of Duration"@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#Duration.Type>;
    shacl:class skos:Concept;
    shacl:description "Type of Duration"@en;
    shacl:maxCount "1";
    shacl:name "type"@en;
    shacl:path dc11:type
  ];
  shacl:targetClass <https://w3id.org/dpv/dpv-owl#Duration> .

<https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#DurationtypeShape> a shacl:NodeShape;
  rdfs:label "DurationType";
  shacl:closed false;
  shacl:targetClass skos:Concept .

<https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#EntityShape> a shacl:NodeShape;
  rdfs:label "Entity"@en;
  <http://purl.org/vocab/vann/usageNote> "To be used as an abstract superclass and to be substituted by an Agent like a Person or Organisation and/or a LegalEntity like a DataSubject, DataController etc."@en;
  rdfs:comment "A human or non-human 'thing' that constitutes as an entity."@en;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "hasRelationWithDataSubject"@en;
    <http://purl.org/vocab/vann/usageNote> "Typically used in case of Consent by delagation, ie to specify that the Entity that indicated the Consent is related to the DataSubject. The kind of relationship is implied by the types of DataSubject and Entity (typically Child and Parent/Guardian of DataSubject respectively)."@en;
    rdfs:comment "Indicates the relation between the Entity and a DataSubject."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#Entity.Hasrelationwithdatasubject>;
    shacl:class <https://w3id.org/dpv/dpv-owl#DataSubject>;
    shacl:description "Indicates the relation between the Entity and a DataSubject."@en;
    shacl:name "hasRelationWithDataSubject"@en;
    shacl:path <https://w3id.org/dpv/dpv-owl#hasRelationWithDataSubject>
  ];
  shacl:targetClass <https://w3id.org/dpv/dpv-owl#Entity> .

<https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#IdentifierShape> a shacl:NodeShape;
  rdfs:label "Identifier"@en;
  <http://purl.org/vocab/vann/usageNote> "The basic principle here is that this string is assigned by an organisation and that this is done according to a well-defined system."@en;
  rdfs:comment "Information used to uniquely identify of an object."@en;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "attributedAt"@en;
    rdfs:comment "The date on which the identifier was issued."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#Identifier.Attributedat>;
    shacl:datatype xsd:dateTime;
    shacl:description "The date on which the identifier was issued."@en;
    shacl:maxCount "1";
    shacl:name "attributedAt"@en;
    shacl:path dc:issued
  ], [
    a shacl:PropertyShape;
    rdfs:label "attributedByAsString"@en;
    rdfs:comment "Name of the Agent that issued the identifier."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#Identifier.Attributedbyasstring>;
    shacl:datatype xsd:string;
    shacl:description "Name of the Agent that issued the identifier."@en;
    shacl:maxCount "1";
    shacl:name "attributedByAsString"@en;
    shacl:path <http://www.w3.org/ns/adms#schemaAgency>
  ], [
    a shacl:PropertyShape;
    rdfs:label "identifier"@en;
    <http://purl.org/vocab/vann/usageNote> "The type of the string refers to the identification system (including its version), the string itself refers to the actual identifier."@en;
    rdfs:comment "String used to uniquely identify the object."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#Identifier.Identifier>;
    shacl:description "String used to uniquely identify the object."@en;
    shacl:maxCount "1";
    shacl:name "identifier"@en;
    shacl:path skos:notation
  ], [
    a shacl:PropertyShape;
    rdfs:label "attributedBy"@en;
    rdfs:comment "Link to the Agent that issued the identifier."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#Identifier.Attributedby>;
    shacl:class dc:Agent;
    shacl:description "Link to the Agent that issued the identifier."@en;
    shacl:maxCount "1";
    shacl:name "attributedBy"@en;
    shacl:path dc:creator
  ];
  shacl:targetClass <http://www.w3.org/ns/adms#Identifier> .

<https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#IndicationmethodtypeShape> a shacl:NodeShape;
  rdfs:label "IndicationMethodType";
  shacl:closed false;
  shacl:targetClass skos:Concept .

<https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#LangstringShape> a shacl:NodeShape;
  rdfs:label "LangString";
  shacl:closed false;
  shacl:targetClass rdf:langString .

<https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#LegalbasisShape> a shacl:NodeShape;
  rdfs:label "LegalBasis"@en;
  <http://purl.org/vocab/vann/usageNote> "REMARK: This profile focusses on one kind of Legal Basis, namely Consent. REMARK: DPV provides the possiblity to use LegalBasis as a category, eg the LegalBasis of PersonalDataHandling123 is Consent."@en;
  rdfs:comment "The legal basis used to justify the Processing of the PersonalData."@en;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "hasPersonalDataHandling"@en;
    rdfs:comment "Indicates the association with the PersonalDataHandling."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#Legalbasis.Haspersonaldatahandling>;
    shacl:class <https://w3id.org/dpv/dpv-owl#PersonalDataHandling>;
    shacl:description "Indicates the association with the PersonalDataHandling."@en;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "hasPersonalDataHandling"@en;
    shacl:path <https://w3id.org/dpv/dpv-owl#hasPersonalDataHandling>
  ];
  shacl:targetClass <https://w3id.org/dpv/dpv-owl#LegalBasis> .

<https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#LegalentityShape> a shacl:NodeShape;
  rdfs:label "LegalEntity"@en;
  <http://purl.org/vocab/vann/usageNote> "Superclass of entities like Data Subject, DataController etc, ie roles with legal importance in the GDPR."@en;
  rdfs:comment "A human or non-human 'thing' that constitutes as an entity and which is recognised and defined in law."@en;
  shacl:closed false;
  shacl:targetClass <https://w3id.org/dpv/dpv-owl#LegalEntity> .

<https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#LiteralShape> a shacl:NodeShape;
  rdfs:label "Literal";
  shacl:closed false;
  shacl:targetClass rdfs:Literal .

<https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#LivedatatypeShape> a shacl:NodeShape;
  rdfs:label "LiveDataType";
  shacl:closed false;
  shacl:targetClass skos:Concept .

<https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#LocationShape> a shacl:NodeShape;
  rdfs:label "Location"@en;
  rdfs:comment "A location can be an identifiable geographic place (ISO 19112), but it can also be a non-geographic place such as a directory, row, or column. As such, there are numerous ways in which location can be expressed, such as by a coordinate, address, landmark, and so forth."@en;
  shacl:closed false;
  shacl:targetClass prov:Location .

<https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#OrganisationShape> a shacl:NodeShape;
  rdfs:label "Organisation"@en;
  shacl:closed false;
  shacl:targetClass org:Organization .

<https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#OrganisationalmeasureShape> a shacl:NodeShape;
  rdfs:label "OrganisationalMeasure";
  shacl:closed false;
  shacl:targetClass skos:Concept .

<https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#PersonShape> a shacl:NodeShape;
  rdfs:label "Person"@en;
  rdfs:comment "A natural person."@en;
  shacl:closed false;
  shacl:targetClass <http://www.w3.org/ns/person#Person> .

<https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#PersonaldataShape> a shacl:NodeShape;
  rdfs:label "PersonalData"@en;
  <http://purl.org/vocab/vann/usageNote> "This definition of personal data encompasses the concepts used in GDPR Art.4-1 for 'personal data' and ISO/IEC 2700 for 'personally identifiable information (PII)'."@en;
  rdfs:comment "Data directly or indirectly associated or related to an individual."@en;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "liveData"@en;
    <http://purl.org/vocab/vann/usageNote> "Eg if the data is from a snaphot or if it is up-to-date."@en;
    rdfs:comment "Indicates how current the data is."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#Personaldata.Livedata>;
    shacl:class skos:Concept;
    shacl:description "Indicates how current the data is."@en;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "liveData"@en;
    shacl:path <https://purl.eu/ns/consent#liveData>
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@en;
    <http://purl.org/vocab/vann/usageNote> "Examples from the DPV codelist are based on the source of the data (like Derived, Inferred, Observed) or on their sensitivity or other. REMARK: More thematic categories can be found in the <a href=\"https://w3c.github.io/dpv/dpv-pd/\" >DPV Extended Personal Data concepts</a> codelist."@en;
    rdfs:comment "Type of PersonalData."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#Personaldata.Type>;
    shacl:class skos:Concept;
    shacl:description "Type of PersonalData."@en;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "type"@en;
    shacl:path dc11:type
  ];
  shacl:targetClass <https://w3id.org/dpv/dpv-owl#PersonalData> .

<https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#PersonaldatahandlingShape> a shacl:NodeShape;
  rdfs:label "PersonalDataHandling"@en;
  <http://purl.org/vocab/vann/usageNote> "REMARK: DPV uses the term 'data handling' to distinguish between the general meaning of processing (eg collect PersonalData from DataSubject123 by DataController456 for the Purpose of marketing) versus the operations pereformed with the data (eg consult, share etc)."@en;
  rdfs:comment "A high-level Class to describe 'data handling'. This can consist of PersonalData being processed for a Purpose, involving Entities, using TechnicalOrganisationalMeasures, applicable Risks, Rights, and LegalBasis."@en;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "hasRight"@en;
    rdfs:comment "Indicates the use or applicability of a Right with the PersonalDataHandling."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#Personaldatahandling.Hasright>;
    shacl:class <https://w3id.org/dpv/dpv-owl#Right>;
    shacl:description "Indicates the use or applicability of a Right with the PersonalDataHandling."@en;
    shacl:name "hasRight"@en;
    shacl:path <https://w3id.org/dpv/dpv-owl#hasRight>
  ], [
    a shacl:PropertyShape;
    rdfs:label "hasRisk"@en;
    rdfs:comment "Indicates the applicability of a Risk associated with the PersonalDataHandling."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#Personaldatahandling.Hasrisk>;
    shacl:class <https://w3id.org/dpv/dpv-owl#Risk>;
    shacl:description "Indicates the applicability of a Risk associated with the PersonalDataHandling."@en;
    shacl:name "hasRisk"@en;
    shacl:path <https://w3id.org/dpv/dpv-owl#hasRisk>
  ], [
    a shacl:PropertyShape;
    rdfs:label "has Technical Organisational Measure"@en;
    <http://purl.org/vocab/vann/usageNote> "Refers to the type of the Technical Organisational Measure that has been taken to protect the the PersonalData. Examples of TechnicalMeasures are Anonymisation, Encryption, WebSecurityProtocols. OrganisationalMeasures could be measures like ConsentNotices, Privacy Notices, CredentialManagement."@en;
    rdfs:comment "Indicates the use or applicability of a Technical Organisational Measure."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#Personaldatahandling.HasTechnicalOrganisationalMeasure>;
    shacl:class skos:Concept;
    shacl:description "Indicates the use or applicability of a Technical Organisational Measure."@en;
    shacl:name "has Technical Organisational Measure"@en;
    shacl:path <https://w3id.org/dpv/dpv-owl#hasTechnicalOrganisationalMeasure>
  ], [
    a shacl:PropertyShape;
    rdfs:label "hasDataSubject"@en;
    rdfs:comment "Indicates the association with the DataSubject."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#Personaldatahandling.Hasdatasubject>;
    shacl:class <https://w3id.org/dpv/dpv-owl#DataSubject>;
    shacl:description "Indicates the association with the DataSubject."@en;
    shacl:minCount "1";
    shacl:name "hasDataSubject"@en;
    shacl:path <https://w3id.org/dpv/dpv-owl#hasDataSubject>
  ], [
    a shacl:PropertyShape;
    rdfs:label "hasProcessing"@en;
    rdfs:comment "Indicates the association with the Processing."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#Personaldatahandling.Hasprocessing>;
    shacl:class <https://w3id.org/dpv/dpv-owl#Processing>;
    shacl:description "Indicates the association with the Processing."@en;
    shacl:minCount "1";
    shacl:name "hasProcessing"@en;
    shacl:path <https://w3id.org/dpv/dpv-owl#hasProcessing>
  ], [
    a shacl:PropertyShape;
    rdfs:label "hasRecipient"@en;
    rdfs:comment "Indicates the Recipient of the PersonalData."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#Personaldatahandling.Hasrecipient>;
    shacl:class <https://w3id.org/dpv/dpv-owl#Recipient>;
    shacl:description "Indicates the Recipient of the PersonalData."@en;
    shacl:name "hasRecipient"@en;
    shacl:path <https://w3id.org/dpv/dpv-owl#hasRecipient>
  ], [
    a shacl:PropertyShape;
    rdfs:label "hasPurpose"@en;
    rdfs:comment "Indicates the association with the Purpose."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#Personaldatahandling.Haspurpose>;
    shacl:class <https://w3id.org/dpv/dpv-owl#Purpose>;
    shacl:description "Indicates the association with the Purpose."@en;
    shacl:minCount "1";
    shacl:name "hasPurpose"@en;
    shacl:path <https://w3id.org/dpv/dpv-owl#hasPurpose>
  ], [
    a shacl:PropertyShape;
    rdfs:label "hasDataController"@en;
    rdfs:comment "Indicates the association with the DataController."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#Personaldatahandling.Hasdatacontroller>;
    shacl:class <https://w3id.org/dpv/dpv-owl#DataController>;
    shacl:description "Indicates the association with the DataController."@en;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "hasDataController"@en;
    shacl:path <https://w3id.org/dpv/dpv-owl#hasDataController>
  ], [
    a shacl:PropertyShape;
    rdfs:label "hasPersonalData"@en;
    rdfs:comment "Indicates the association with the PersonalData."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#Personaldatahandling.Haspersonaldata>;
    shacl:class <https://w3id.org/dpv/dpv-owl#PersonalData>;
    shacl:description "Indicates the association with the PersonalData."@en;
    shacl:minCount "1";
    shacl:name "hasPersonalData"@en;
    shacl:path <https://w3id.org/dpv/dpv-owl#hasPersonalData>
  ], [
    a shacl:PropertyShape;
    rdfs:label "hasLegalBasis"@en;
    rdfs:comment "Indicates the use or applicability of a LegalBasis."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#Personaldatahandling.Haslegalbasis>;
    shacl:class <https://w3id.org/dpv/dpv-owl#LegalBasis>;
    shacl:description "Indicates the use or applicability of a LegalBasis."@en;
    shacl:minCount "1";
    shacl:name "hasLegalBasis"@en;
    shacl:path <https://w3id.org/dpv/dpv-owl#hasLegalBasis>
  ], [
    a shacl:PropertyShape;
    rdfs:label "hasDataProcessor"@en;
    rdfs:comment "Indicates the inclusion or applicability of a DataProcessor."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#Personaldatahandling.Hasdataprocessor>;
    shacl:class <https://w3id.org/dpv/dpv-owl#DataProcessor>;
    shacl:description "Indicates the inclusion or applicability of a DataProcessor."@en;
    shacl:name "hasDataProcessor"@en;
    shacl:path <https://w3id.org/dpv/dpv-owl#hasDataProcessor>
  ];
  shacl:targetClass <https://w3id.org/dpv/dpv-owl#PersonalDataHandling> .

<https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#PersonaldatatypeShape> a shacl:NodeShape;
  rdfs:label "PersonalDataType";
  shacl:closed false;
  shacl:targetClass skos:Concept .

<https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#ProcessingShape> a shacl:NodeShape;
  rdfs:label "Processing"@en;
  rdfs:comment "The processing performed on the Personal Data."@en;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "hasStorageCondition"@en;
    rdfs:comment "Indicates information about the storage of the PersonalData."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#Processing.Hasstoragecondition>;
    shacl:class <https://w3id.org/dpv/dpv-owl#StorageCondition>;
    shacl:description "Indicates information about the storage of the PersonalData."@en;
    shacl:maxCount "1";
    shacl:name "hasStorageCondition"@en;
    shacl:path <https://w3id.org/dpv/dpv-owl#hasStorageCondition>
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@en;
    <http://purl.org/vocab/vann/usageNote> "Refers to the kind of operation that is performed  on the PersonalData. Examples are Collect, Disclose, Share."@en;
    rdfs:comment "Type of Processing."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#Processing.Type>;
    shacl:class skos:Concept;
    shacl:description "Type of Processing."@en;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "type"@en;
    shacl:path dc11:type
  ];
  shacl:targetClass <https://w3id.org/dpv/dpv-owl#Processing> .

<https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#ProcessingtypeShape> a shacl:NodeShape;
  rdfs:label "ProcessingType";
  shacl:closed false;
  shacl:targetClass skos:Concept .

<https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#PurposeShape> a shacl:NodeShape;
  rdfs:label "Purpose"@en;
  rdfs:comment "The purpose of processing the PersonalData."@en;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "type"@en;
    <http://purl.org/vocab/vann/usageNote> "Refers to the reason or justification for the PersonalDataHandling. Examples in the context of Consent are Marketing, Personalised Advertising, Commercial research."@en;
    rdfs:comment "Type of Purpose."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#Purpose.Type>;
    shacl:class skos:Concept;
    shacl:description "Type of Purpose."@en;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "type"@en;
    shacl:path dc11:type
  ];
  shacl:targetClass <https://w3id.org/dpv/dpv-owl#Purpose> .

<https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#PurposetypeShape> a shacl:NodeShape;
  rdfs:label "PurposeType";
  shacl:closed false;
  shacl:targetClass skos:Concept .

<https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#RecipientShape> a shacl:NodeShape;
  rdfs:label "Recipient"@en;
  <http://purl.org/vocab/vann/usageNote> "A Recipient of Personal Data can be used to indicate any Entity that receives the data. This can be a Third Party, Processor (GDPR), or even a Controller."@en;
  rdfs:comment "Entitiy that receives the PersonalData."@en;
  shacl:closed false;
  shacl:targetClass <https://w3id.org/dpv/dpv-owl#Recipient> .

<https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#RegisteredPersonShape> a shacl:NodeShape;
  rdfs:label "Registered Person"@en;
  rdfs:comment "Person whose information is recorded in a register."@en;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "fullName"@en;
    rdfs:comment "The full name of the person, in a general a combination of the first and last name."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#RegisteredPerson.Fullname>;
    shacl:datatype xsd:string;
    shacl:description "The full name of the person, in a general a combination of the first and last name."@en;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "fullName"@en;
    shacl:path <https://data.vlaanderen.be/ns/persoon#volledigeNaam>
  ], [
    a shacl:PropertyShape;
    rdfs:label "registration"@en;
    rdfs:comment "Identification code of the person in the register."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#RegisteredPerson.Registration>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Identification code of the person in the register."@en;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "registration"@en;
    shacl:path <https://data.vlaanderen.be/ns/persoon#registratie>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/persoon#GeregistreerdPersoon> .

<https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#RegisteredorganisationShape> a shacl:NodeShape;
  rdfs:label "RegisteredOrganisation"@en;
  rdfs:comment "An organization that is legally registered"@en;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "legalName"@en;
    rdfs:comment "The legal name of the organisation."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#Registeredorganisation.Legalname>;
    shacl:datatype rdf:langString;
    shacl:description "The legal name of the organisation."@en;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "legalName"@en;
    shacl:path <http://www.w3.org/ns/regorg#legalName>
  ], [
    a shacl:PropertyShape;
    rdfs:label "registration"@en;
    rdfs:comment "The registration is a fundamental relationship between a legal entity and the authority with which it is registered and that confers legal status upon it."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#Registeredorganisation.Registration>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "The registration is a fundamental relationship between a legal entity and the authority with which it is registered and that confers legal status upon it."@en;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "registration"@en;
    shacl:path <http://www.w3.org/ns/regorg#registration>
  ];
  shacl:targetClass <http://www.w3.org/ns/regorg#RegisteredOrganization> .

<https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#RightShape> a shacl:NodeShape;
  rdfs:label "Right"@en;
  <http://purl.org/vocab/vann/usageNote> "A 'right' is a legal, social, or ethical principle of freedom or entitlement which dictates the norms regarding what is allowed or owed. Rights as a concept encompass a broad area of norms and entities, and are not specific to individuals or Data Protection / Privacy. REMARK: For individual specific rights, see DPV:DataSubjectRight and <a href=\"https://w3c.github.io/dpv/rights/eu/\">EU Fundamental Rights</a>."@en;
  rdfs:comment "The right(s) applicable, provided, or expected."@en;
  shacl:closed false;
  shacl:targetClass <https://w3id.org/dpv/dpv-owl#Right> .

<https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#RiskShape> a shacl:NodeShape;
  rdfs:label "Risk"@en;
  <http://purl.org/vocab/vann/usageNote> "Risks can be associated with one or more different concepts such as Purpose, Processing, PersonalData, TechnicalOrganisationalMeasures. REMARK: More info on this class in <a href=\"https://w3c.github.io/dpv/risk/\">DPV-Risk</a>."@en;
  rdfs:comment "A risk or possibility or uncertainty of negative effects, impacts, or consequences."@en;
  shacl:closed false;
  shacl:targetClass <https://w3id.org/dpv/dpv-owl#Risk> .

<https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#StorageconditionShape> a shacl:NodeShape;
  rdfs:label "StorageCondition"@en;
  <http://purl.org/vocab/vann/usageNote> "When the type of Processing is 'store', subclasses of this abstract class allow to specify duration, location etc of the storage."@en;
  rdfs:comment "Conditions required or followed regarding storage of data."@en;
  shacl:closed false;
  shacl:targetClass <https://w3id.org/dpv/dpv-owl#StorageCondition> .

<https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#StoragedurationShape> a shacl:NodeShape;
  rdfs:label "StorageDuration"@en;
  rdfs:comment "Duration or temporal limitation on the storage of the PersonalData."@en;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "hasDuration"@en;
    <http://purl.org/vocab/vann/usageNote> "For example how long the data is stored (eg 6 months), or until what time (eg 31 december 2022) or until which event (eg account closure)."@en;
    rdfs:comment "Indicates information about the Duration of the storage."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#Storageduration.Hasduration>;
    shacl:class <https://w3id.org/dpv/dpv-owl#Duration>;
    shacl:description "Indicates information about the Duration of the storage."@en;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "hasDuration"@en;
    shacl:path <https://w3id.org/dpv/dpv-owl#hasDuration>
  ];
  shacl:targetClass <https://w3id.org/dpv/dpv-owl#StorageDuration> .

<https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#StringShape> a shacl:NodeShape;
  rdfs:label "String";
  shacl:closed false;
  shacl:targetClass xsd:string .

<https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#TechnicalmeasureShape> a shacl:NodeShape;
  rdfs:label "TechnicalMeasure";
  shacl:closed false;
  shacl:targetClass skos:Concept .
