    shacl:path skos:notation
  ], [
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#Identifier.Attributedby>;
    shacl:class dc:Agent;
    shacl:description "Link to the Agent that issued the identifier."@en;
    shacl:maxCount "1";
    shacl:name "attributedBy"@en;
    shacl:path dc:creator
  ];
  shacl:targetClass <http://www.w3.org/ns/adms#Identifier> .

