    shacl:path <http://www.w3.org/ns/adms#schemaAgency>
  ], [
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/ontwerpstandaard/toolchain4#Identifier.Identifier>;
    shacl:description "String used to uniquely identify the object."@en;
    shacl:maxCount "1";
