<https://purl.eu/doc/applicationprofile/consent/kandidaatstandaard/2022-02-23#ConsentShape> a shacl:NodeShape;
  shacl:closed false;
  shacl:property [
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/kandidaatstandaard/2022-02-23#Consent.Isindicatedattime>;
    shacl:datatype xsd:dateTime;
    shacl:description "Moment when this stage of the Consent was created."@en;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "isIndicatedAtTime"@en;
    shacl:path <https://w3id.org/dpv/dpv-owl#isIndicatedAtTime>
  ], [
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/kandidaatstandaard/2022-02-23#Consent.Hasconsentstatus>;
    shacl:class skos:Concept;
    shacl:description "Specifies the state or status of consent."@en;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "hasConsentStatus"@en;
    shacl:path <https://w3id.org/dpv/dpv-owl#hasConsentStatus>
  ], [
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/kandidaatstandaard/2022-02-23#Consent.Hasduration>;
    shacl:class <https://w3id.org/dpv/dpv-owl#Duration>;
    shacl:description "Indicates information about the Duration of the Consent."@en;
    shacl:maxCount "1";
    shacl:name "hasDuration"@en;
    shacl:path <https://w3id.org/dpv/dpv-owl#hasDuration>
  ], [
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/kandidaatstandaard/2022-02-23#Consent.Haslocation>;
    shacl:class prov:Location;
    shacl:description "Location where this stage of the Consent was created."@en;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "hasLocation"@en;
    shacl:path <https://w3id.org/dpv/dpv-owl#hasLocation>
  ], [
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/kandidaatstandaard/2022-02-23#Consent.Hasnotice>;
    shacl:class <https://w3id.org/dpv/dpv-owl#ConsentNotice>;
    shacl:description "Reference to the applied or used ConsentNotice."@en;
    shacl:name "hasNotice"@en;
    shacl:path <https://w3id.org/dpv/dpv-owl#hasNotice>
  ], [
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/kandidaatstandaard/2022-02-23#Consent.Hasindicationmethod>;
    shacl:class skos:Concept;
    shacl:description "Way in which the current state of Consent realized."@en;
    shacl:maxCount "1";
    shacl:name "hasIndicationMethod"@en;
    shacl:path <https://w3id.org/dpv#hasIndicationMethod>
  ], [
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/kandidaatstandaard/2022-02-23#Consent.Isindicatedby>;
    shacl:class <https://w3id.org/dpv/dpv-owl#Entity>;
    shacl:description "Entity that is responsible for this stage of the Consent."@en;
    shacl:maxCount "1";
    shacl:name "isIndicatedBy"@en;
    shacl:path <https://w3id.org/dpv/dpv-owl#isIndicatedBy>
  ], [
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/consent/kandidaatstandaard/2022-02-23#Consent.Hasdatasubject>;
    shacl:class <https://w3id.org/dpv/dpv-owl#DataSubject>;
    shacl:description "Indicates the association of the Consent with a DataSubject."@en;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "hasDataSubject"@en;
    shacl:path <https://w3id.org/dpv/dpv-owl#hasDataSubject>
  ];
  shacl:targetClass <https://w3id.org/dpv/dpv-owl#Consent> .

