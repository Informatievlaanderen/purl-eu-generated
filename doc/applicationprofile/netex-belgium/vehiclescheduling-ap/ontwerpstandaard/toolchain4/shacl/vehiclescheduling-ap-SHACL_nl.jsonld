  {
    "@id": "https://purl.eu/doc/applicationprofile/netex-belgium/vehiclescheduling-ap/ontwerpstandaard/toolchain4#RitpatroonShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "Abstracte klasse."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Het Ritpatroon geeft een ruimtelijke beschrijving van de dienst, m.a.w. hoe deze ruimtelijk wordt uitgevoerd. Waar Routes en Lijnen het pad weergeven dat in het netwerk wordt gevolgd, zegt het Ritpatroon hoe deze paden worden uitgevoerd. Als het om een Dienstpatroon gaat beschrijft het Ritpatroon de volgorde van punten waar wordt gestopt (de Geplande Stopplaatsen) met hun Doorkomsttijden. \n\nHet Ritpatroon is geassocieerd met de Route die ze volgt, meerdere Ritpatronen kunnen dezelfde Route volgen."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "Ritpatroon"
      }
    ],
    "http://www.w3.org/ns/shacl#closed": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#boolean",
        "@value": "false"
      }
    ],
