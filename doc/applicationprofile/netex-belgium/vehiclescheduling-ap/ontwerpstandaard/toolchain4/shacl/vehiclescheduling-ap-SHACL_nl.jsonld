    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Beter leesbare weergave van een gestructureerd adres met alleen de basis- of gecombineerde gegevens, bedoeld voor het gebruik van een adres als attribuut van een ander object of als label."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
