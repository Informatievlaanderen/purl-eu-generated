    shacl:description "Transport object on which the Mobility Service is offered."@en;
    shacl:name "availableAt"@en;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#beschikbaarOp>
  ], [
    a shacl:PropertyShape;
    rdfs:label "availableAtInfrastructureElement"@en;
    <http://purl.org/vocab/vann/usageNote> "E.g. public transport such as buses are offered at a bus stop."@en;
    rdfs:comment "Infrastructure element on which the Mobility Service is available"@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/mobility/passenger-transport-hubs/ontwerpstandaard/toolchain4#Mobilityservice.Availableatinfrastructureelement>;
