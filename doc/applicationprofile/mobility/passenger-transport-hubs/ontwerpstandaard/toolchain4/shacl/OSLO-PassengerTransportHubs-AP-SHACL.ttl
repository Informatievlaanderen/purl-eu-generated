<https://purl.eu/doc/applicationprofile/mobility/passenger-transport-hubs/ontwerpstandaard/toolchain4#TransportconnectionShape> a shacl:NodeShape;
  rdfs:label "TransportConnection"@en;
  rdfs:comment "Logical connection between two or more Transport objects in different Transport Networks."@en;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "type"@en;
    rdfs:comment "Nature of the Transport connection"@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/mobility/passenger-transport-hubs/ontwerpstandaard/toolchain4#Transportconnection.Type>;
    shacl:class skos:Concept;
    shacl:description "Nature of the Transport connection"@en;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "type"@en;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "identifier"@en;
    rdfs:comment "Identifier of the Transport connection"@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/mobility/passenger-transport-hubs/ontwerpstandaard/toolchain4#Transportconnection.Identifier>;
    shacl:class <http://www.w3.org/ns/adms#Identifier>;
    shacl:description "Identifier of the Transport connection"@en;
    shacl:maxCount "1";
    shacl:name "identifier"@en;
    shacl:path <http://www.w3.org/ns/adms#identifier>
  ], [
    a shacl:PropertyShape;
    rdfs:label "connects"@en;
    rdfs:comment "Network elements connected by the Connection."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/mobility/passenger-transport-hubs/ontwerpstandaard/toolchain4#Transportconnection.Connects>;
    shacl:class <https://data.vlaanderen.be/ns/transportnetwerk#Transportobject>;
    shacl:description "Network elements connected by the Connection."@en;
    shacl:minCount 2;
    shacl:name "connects"@en;
    shacl:path <https://data.vlaanderen.be/ns/netwerk#verbindt>
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#TransportConnection> .

<https://purl.eu/doc/applicationprofile/mobility/passenger-transport-hubs/ontwerpstandaard/toolchain4#TransporthubShape> a shacl:NodeShape;
  rdfs:label "TransportHub"@en;
  <http://purl.org/vocab/vann/usageNote> "Examples for passenger transport are train stations, underground stations, bus stations, airports, ferry terminals, car parks... For freight transport it concerns typically airports, seaports, transhipment terminals. Transport hubs are typically intermodal, e.g. travellers combine the (shared) bicycle with the train for their trip, but intramodal transfers (e.g. from one bus line to another) are also important. Concretely, a Transport hub includes infrastructure (stations, car parks, charging infrastructure... ), (mobility) services (public transport lines, shared bicycles, shops... ) and nodes in transport networks (public transport stops, car sharing points... )."@en;
  rdfs:comment "Place where passengers and/or freight are exchanged between vehicles and/or modes of transport."@en;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "title"@en;
    rdfs:comment "The name of the Passenger Transport Hub."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/mobility/passenger-transport-hubs/ontwerpstandaard/toolchain4#Transporthub.Title>;
    shacl:datatype rdf:langString;
    shacl:description "The name of the Passenger Transport Hub."@en;
    shacl:name "title"@en;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "classification"@en;
    rdfs:comment "The classification of the Passenger Transport Hub."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/mobility/passenger-transport-hubs/ontwerpstandaard/toolchain4#Transporthub.Classification>;
    shacl:class skos:Concept;
    shacl:description "The classification of the Passenger Transport Hub."@en;
    shacl:name "classification"@en;
    shacl:path <https://purl.eu/ns/mobility/passenger-transport-hubs#TransportHub.classification>
  ], [
    a shacl:PropertyShape;
    rdfs:label "accessibility"@en;
    rdfs:comment "The accessibility of the Passenger Transport Hub."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/mobility/passenger-transport-hubs/ontwerpstandaard/toolchain4#Transporthub.Accessibility>;
    shacl:class <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Accessibility>;
    shacl:description "The accessibility of the Passenger Transport Hub."@en;
    shacl:name "accessibility"@en;
    shacl:path <https://purl.eu/ns/mobility/passenger-transport-hubs#TransportHub.accessibility>
  ], [
    a shacl:PropertyShape;
    rdfs:label "location"@en;
    rdfs:comment "The location of the Passenger Transport Hub."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/mobility/passenger-transport-hubs/ontwerpstandaard/toolchain4#Transporthub.Location>;
    shacl:class prov:Location;
    shacl:description "The location of the Passenger Transport Hub."@en;
    shacl:name "location"@en;
    shacl:path dc:spatial
  ], [
    a shacl:PropertyShape;
    rdfs:label "brand"@en;
    <http://purl.org/vocab/vann/usageNote> "Example: Hoppinpoint, Mobipoint,..."@en;
    rdfs:comment "The brand of the Passenger Transport Hub."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/mobility/passenger-transport-hubs/ontwerpstandaard/toolchain4#Transporthub.Brand>;
    shacl:class skos:Concept;
    shacl:description "The brand of the Passenger Transport Hub."@en;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "brand"@en;
    shacl:path <https://purl.eu/ns/mobility/passenger-transport-hubs#TransportHub.brand>
  ], [
    a shacl:PropertyShape;
    rdfs:label "status"@en;
    rdfs:comment "The status of the Passenger Transport Hub."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/mobility/passenger-transport-hubs/ontwerpstandaard/toolchain4#Transporthub.Status>;
    shacl:class skos:Concept;
    shacl:description "The status of the Passenger Transport Hub."@en;
    shacl:maxCount "1";
    shacl:name "status"@en;
    shacl:path <https://purl.eu/ns/mobility/passenger-transport-hubs#TransportHub.status>
  ], [
    a shacl:PropertyShape;
    rdfs:label "roadAuthority"@en;
    rdfs:comment "The road authority of the Passenger Transport Hub."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/mobility/passenger-transport-hubs/ontwerpstandaard/toolchain4#Transporthub.Roadauthority>;
    shacl:class dc:Agent;
    shacl:description "The road authority of the Passenger Transport Hub."@en;
    shacl:name "roadAuthority"@en;
    shacl:path <https://purl.eu/ns/mobility/passenger-transport-hubs#TransportHub.roadAuthority>
  ], [
    a shacl:PropertyShape;
    rdfs:label "transportObject"@en;
    rdfs:comment "The transport object of the Passenger Transport Hub."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/mobility/passenger-transport-hubs/ontwerpstandaard/toolchain4#Transporthub.Transportobject>;
    shacl:class <https://data.vlaanderen.be/ns/transportnetwerk#Transportobject>;
    shacl:description "The transport object of the Passenger Transport Hub."@en;
    shacl:name "transportObject"@en;
    shacl:path <https://purl.eu/ns/mobility/passenger-transport-hubs#transportObject>
  ], [
    a shacl:PropertyShape;
    rdfs:label "service"@en;
    rdfs:comment "The mobility services connected to the Passenger Transport Hub."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/mobility/passenger-transport-hubs/ontwerpstandaard/toolchain4#Transporthub.Service>;
    shacl:class <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#MobilityService>;
    shacl:description "The mobility services connected to the Passenger Transport Hub."@en;
    shacl:name "service"@en;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#dienst>
  ], [
    a shacl:PropertyShape;
    rdfs:label "infrastructureElement"@en;
    rdfs:comment "The infrastructure element of the Passenger Transport Hub."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/mobility/passenger-transport-hubs/ontwerpstandaard/toolchain4#Transporthub.Infrastructureelement>;
    shacl:class <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Infrastructuurelement>;
    shacl:description "The infrastructure element of the Passenger Transport Hub."@en;
    shacl:name "infrastructureElement"@en;
    shacl:path <https://purl.eu/ns/mobility/passenger-transport-hubs#infrastructureElement>
  ], [
    a shacl:PropertyShape;
    rdfs:label "additionalService"@en;
    rdfs:comment "The additional services connected to the Passenger Transport Hub."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/mobility/passenger-transport-hubs/ontwerpstandaard/toolchain4#Transporthub.Additionalservice>;
    shacl:class <https://purl.eu/ns/mobility/passenger-transport-hubs#AdditionalService>;
    shacl:description "The additional services connected to the Passenger Transport Hub."@en;
    shacl:name "additionalService"@en;
    shacl:path <https://purl.eu/ns/mobility/passenger-transport-hubs#additionalService>
  ];
  shacl:targetClass <https://purl.eu/ns/mobility/passenger-transport-hubs#TransportHub> .

