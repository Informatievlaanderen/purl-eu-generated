    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#realisedAt>
  ], [
    a shacl:PropertyShape;
    rdfs:label "RouteNode (source)";
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/mobility/passenger-transport-hubs/ontwerpstandaard/toolchain4#Transfer.Routenode(source)>;
