<https://purl.eu/doc/applicationprofile/mobility/passenger-transport-hubs/ontwerpstandaard/toolchain4#ParkingfacilityShape> a shacl:NodeShape;
  rdfs:label "ParkingFacility"@en;
  rdfs:comment "A facility used for parking vehicles."@en;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "openingHours"@en;
