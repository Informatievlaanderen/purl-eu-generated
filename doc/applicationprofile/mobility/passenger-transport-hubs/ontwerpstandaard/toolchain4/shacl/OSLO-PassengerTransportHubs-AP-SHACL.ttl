<https://purl.eu/doc/applicationprofile/mobility/passenger-transport-hubs/ontwerpstandaard/toolchain4#HoppinpointShape> a shacl:NodeShape;
  rdfs:label "Hoppinpoint"@en;
  <http://purl.org/vocab/vann/usageNote> "Hoppin is the name under which the Flemish government indicates transport hubs for passenger transport that meet fixed (quality) requirements. Important aspects are recognisability (application of the Hoppin house style), accessibility (for all users irrespective of disability, age, etc.), minimum equipment (e.g. bicycle sheds, information supports, etc.), alignment with mobility plans, etc."@en;
  rdfs:comment "Transport hub of the mobility brand Hoppin."@en;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "classification"@en;
    rdfs:comment "The classification of the Hoppinpoint"@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/mobility/passenger-transport-hubs/ontwerpstandaard/toolchain4#Hoppinpoint.Classification>;
