    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#offeredWithin>
  ], [
    a shacl:PropertyShape;
    rdfs:label "license"@en;
    rdfs:comment "License under which the Mobility Service is offered."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/mobility/passenger-transport-hubs/ontwerpstandaard/toolchain4#Mobilityservice.License>;
    shacl:class <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#License>;
    shacl:description "License under which the Mobility Service is offered."@en;
    shacl:name "license"@en;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#license>
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@en;
    <http://purl.org/vocab/vann/usageNote> "E.g. public transport, parking etc. Combinations are possible, e.g. collective transport & public transport (e.g. SNCB), individual transport & private transport (taxis)…"@en;
    rdfs:comment "Nature of the Mobility Service."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/mobility/passenger-transport-hubs/ontwerpstandaard/toolchain4#Mobilityservice.Type>;
    shacl:class skos:Concept;
    shacl:description "Nature of the Mobility Service."@en;
    shacl:minCount "1";
    shacl:name "type"@en;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "priceSpecification"@en;
