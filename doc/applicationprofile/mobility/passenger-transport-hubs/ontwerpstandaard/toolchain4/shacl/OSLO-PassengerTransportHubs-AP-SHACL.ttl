    shacl:class <http://www.w3.org/ns/locn#Geometry>;
    shacl:description "Geometry of the place or area."@en;
    shacl:maxCount "1";
    shacl:name "geometry"@en;
    shacl:path <http://www.w3.org/ns/locn#geometry>
  ];
  shacl:targetClass dc:Location,
    prov:Location .

