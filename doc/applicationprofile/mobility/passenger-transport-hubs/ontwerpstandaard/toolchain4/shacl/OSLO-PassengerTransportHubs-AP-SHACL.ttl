    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Mobiliteitsdienst.toegankelijkheid>
  ], [
    a shacl:PropertyShape;
    rdfs:label "meansOfTransport"@en;
    <http://purl.org/vocab/vann/usageNote> "E.g. metro, tram, bus for STIB. E.g. car, bicycle for parking Coovi."@en;
