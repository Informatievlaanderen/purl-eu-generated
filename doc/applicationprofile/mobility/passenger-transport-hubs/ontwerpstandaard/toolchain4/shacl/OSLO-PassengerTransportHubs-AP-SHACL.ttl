    shacl:name "transportHub"@en;
    shacl:path <https://purl.eu/ns/mobility/passenger-transport-hubs#transportHub>
  ], [
    a shacl:PropertyShape;
    rdfs:label "availableAtInfrastructureElement"@en;
    rdfs:comment "Infrastructure element on which the additional service is offered."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/mobility/passenger-transport-hubs/ontwerpstandaard/toolchain4#Additionalservice.Availableatinfrastructureelement>;
    shacl:class <https://data.vlaanderen.be/ns/openbaardomein/infrastructuur#Infrastructuurelement>;
