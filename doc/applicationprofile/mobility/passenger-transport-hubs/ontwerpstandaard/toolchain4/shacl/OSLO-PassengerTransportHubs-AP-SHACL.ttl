    shacl:name "availableAtInfrastructureElement"@en;
    shacl:path <https://purl.eu/ns/mobility/passenger-transport-hubs#MobilityService.availableAtInfrastructureElement>
  ], [
    a shacl:PropertyShape;
    rdfs:label "transportHub"@en;
    rdfs:comment "The transport hub  to which the Mobility Service is linked."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/mobility/passenger-transport-hubs/ontwerpstandaard/toolchain4#Mobilityservice.Transporthub>;
