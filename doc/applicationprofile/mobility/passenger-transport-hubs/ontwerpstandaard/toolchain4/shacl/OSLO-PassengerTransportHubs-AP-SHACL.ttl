    shacl:path <https://purl.eu/ns/mobility/passenger-transport-hubs#Hoppinpoint.classification>
  ], [
    a shacl:PropertyShape;
    rdfs:label "status"@en;
    rdfs:comment "The status of the Hoppinpoint"@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/mobility/passenger-transport-hubs/ontwerpstandaard/toolchain4#Hoppinpoint.Status>;
    shacl:class skos:Concept;
    shacl:description "The status of the Hoppinpoint"@en;
    shacl:maxCount "1";
    shacl:name "status"@en;
    shacl:path <https://purl.eu/ns/mobility/passenger-transport-hubs#Hoppinpoint.status>
  ];
  shacl:targetClass <https://purl.eu/ns/mobility/passenger-transport-hubs#Hoppinpoint> .

