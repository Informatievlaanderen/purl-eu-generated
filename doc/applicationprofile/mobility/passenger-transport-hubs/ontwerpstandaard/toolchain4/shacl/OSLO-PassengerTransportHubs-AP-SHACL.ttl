<https://purl.eu/doc/applicationprofile/mobility/passenger-transport-hubs/ontwerpstandaard/toolchain4#AccessibilityShape> a shacl:NodeShape;
  rdfs:label "Accessibility"@en;
  <http://purl.org/vocab/vann/usageNote> "E.g. physical accessibility of a service or building for people with disabilities."@en;
  rdfs:comment "Degree to which something can be accessed."@en;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "component"@en;
    rdfs:comment "Part of the service or infrastructure to which Accessibility relates."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/mobility/passenger-transport-hubs/ontwerpstandaard/toolchain4#Accessibility.Component>;
    shacl:class skos:Concept;
    shacl:description "Part of the service or infrastructure to which Accessibility relates."@en;
    shacl:maxCount "1";
    shacl:name "component"@en;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#component>
  ], [
    a shacl:PropertyShape;
    rdfs:label "level"@en;
    rdfs:comment "Level of accessibility."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/mobility/passenger-transport-hubs/ontwerpstandaard/toolchain4#Accessibility.Level>;
    shacl:class skos:Concept;
    shacl:description "Level of accessibility."@en;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "level"@en;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#level>
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@en;
    rdfs:comment "Nature of the accessibility"@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/mobility/passenger-transport-hubs/ontwerpstandaard/toolchain4#Accessibility.Type>;
    shacl:class skos:Concept;
    shacl:description "Nature of the accessibility"@en;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "type"@en;
    shacl:path dc:type
  ];
  shacl:targetClass <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Accessibility> .

