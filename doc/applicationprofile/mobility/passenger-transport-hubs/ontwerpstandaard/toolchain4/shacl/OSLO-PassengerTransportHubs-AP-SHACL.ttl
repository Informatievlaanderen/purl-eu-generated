<https://purl.eu/doc/applicationprofile/mobility/passenger-transport-hubs/ontwerpstandaard/toolchain4#MobilityserviceShape> a shacl:NodeShape;
  rdfs:label "MobilityService"@en;
  <http://purl.org/vocab/vann/usageNote> "This includes classical mobility services such as public transport (typically offered as a scheduled service, e.g. Metro Line 5 in Brussels), but also partial transport such as free-floating partial steps (e.g. partial steps in large cities)."@en;
  rdfs:comment "Service that enables movement of Persons between Locations."@en;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "title"@en;
    rdfs:comment "Name of the Mobility Service."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/mobility/passenger-transport-hubs/ontwerpstandaard/toolchain4#Mobilityservice.Title>;
    shacl:datatype rdf:langString;
