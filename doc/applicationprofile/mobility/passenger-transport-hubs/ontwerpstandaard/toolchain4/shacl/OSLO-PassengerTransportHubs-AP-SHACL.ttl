    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/mobility/passenger-transport-hubs/ontwerpstandaard/toolchain4#Transportnetwork.Consistsof>;
    shacl:class <https://data.vlaanderen.be/ns/transportnetwerk#Transportobject>;
    shacl:description "Transport objects that make up the Transport network."@en;
