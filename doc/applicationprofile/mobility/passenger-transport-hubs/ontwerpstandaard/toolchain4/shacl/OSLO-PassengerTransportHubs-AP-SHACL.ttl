<https://purl.eu/doc/applicationprofile/mobility/passenger-transport-hubs/ontwerpstandaard/toolchain4#PeriodShape> a shacl:NodeShape;
  rdfs:label "Period"@en;
  <http://purl.org/vocab/vann/usageNote> "Typically, the duration follows from the specification of the start and end time."@en;
