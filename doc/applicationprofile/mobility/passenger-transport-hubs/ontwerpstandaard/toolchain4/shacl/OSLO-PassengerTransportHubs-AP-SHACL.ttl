    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/mobility/passenger-transport-hubs/ontwerpstandaard/toolchain4#License.Transportauthority>;
    shacl:class <http://data.europa.eu/m8g/PublicOrganisation>;
    shacl:description "Public organisation responsible for traffic management or the planning, control or management of a particular transport network or mode of transport, or both, that falls under its territorial competence."@en;
    shacl:maxCount "1";
