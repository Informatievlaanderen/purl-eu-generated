    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "period"@en;
    shacl:path dc:date
  ], [
    a shacl:PropertyShape;
    rdfs:label "territorialApplication"@en;
    rdfs:comment "Area or Place in which the Licence is valid."@en;
