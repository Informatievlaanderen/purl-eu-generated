    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#performedBy>
  ], [
    a shacl:PropertyShape;
    rdfs:label "offeredWithin"@en;
    <http://purl.org/vocab/vann/usageNote> "E.g. Decree listing the criteria for authorising a Mobility Service."@en;
    rdfs:comment "Formal Framework within which the Mobility Service is offered."@en;
