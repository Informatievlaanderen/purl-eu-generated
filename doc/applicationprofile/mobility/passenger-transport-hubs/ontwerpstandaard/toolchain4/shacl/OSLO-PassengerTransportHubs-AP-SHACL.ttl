<https://purl.eu/doc/applicationprofile/mobility/passenger-transport-hubs/ontwerpstandaard/toolchain4#AdditionalserviceShape> a shacl:NodeShape;
  rdfs:label "AdditionalService"@en;
  <http://purl.org/vocab/vann/usageNote> "E.g. Newspaper shop, Postal service or Restaurant in a Station. Services that are supplemented or supported by this are e.g. Mobility Services."@en;
  rdfs:comment "Service that complements or supports other Services."@en;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "title"@en;
    rdfs:comment "Name of the additional service."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/mobility/passenger-transport-hubs/ontwerpstandaard/toolchain4#Additionalservice.Title>;
    shacl:datatype rdf:langString;
    shacl:description "Name of the additional service."@en;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "title"@en;
    shacl:path dc:title
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@en;
    <http://purl.org/vocab/vann/usageNote> "E.g. ticketing, waiting facilities, sanitary facilities, AED..."@en;
    rdfs:comment "Nature of the additional service."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/mobility/passenger-transport-hubs/ontwerpstandaard/toolchain4#Additionalservice.Type>;
    shacl:class skos:Concept;
    shacl:description "Nature of the additional service."@en;
    shacl:minCount "1";
    shacl:name "type"@en;
    shacl:path dc:type
  ], [
    a shacl:PropertyShape;
    rdfs:label "availability"@en;
    <http://purl.org/vocab/vann/usageNote> "E.g. timetable or opening hours."@en;
    rdfs:comment "Availability of the additional service."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/mobility/passenger-transport-hubs/ontwerpstandaard/toolchain4#Additionalservice.Availability>;
    shacl:class <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Provider>;
    shacl:description "Availability of the additional service."@en;
    shacl:name "availability"@en;
    shacl:path <https://purl.eu/ns/mobility/passenger-transport-hubs#AdditionalService.availability>
  ], [
    a shacl:PropertyShape;
    rdfs:label "accessibility"@en;
    <http://purl.org/vocab/vann/usageNote> "E.g. whether the Mobility Service is accessible to persons with disabilities."@en;
    rdfs:comment "Accessibility of the additional service."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/mobility/passenger-transport-hubs/ontwerpstandaard/toolchain4#Additionalservice.Accessibility>;
    shacl:class <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Accessibility>;
    shacl:description "Accessibility of the additional service."@en;
    shacl:name "accessibility"@en;
    shacl:path <https://purl.eu/ns/mobility/passenger-transport-hubs#AdditionalService.accessibility>
  ], [
    a shacl:PropertyShape;
    rdfs:label "provider"@en;
    rdfs:comment "The provider of the additional service."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/mobility/passenger-transport-hubs/ontwerpstandaard/toolchain4#Additionalservice.Provider>;
    shacl:class <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Provider>;
    shacl:description "The provider of the additional service."@en;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "provider"@en;
    shacl:path <https://purl.eu/ns/mobility/passenger-transport-hubs#AdditionalService.provider>
  ], [
    a shacl:PropertyShape;
    rdfs:label "transportHub"@en;
    rdfs:comment "The Passenger Transport Hub at which the additional service is offered."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/mobility/passenger-transport-hubs/ontwerpstandaard/toolchain4#Additionalservice.Transporthub>;
