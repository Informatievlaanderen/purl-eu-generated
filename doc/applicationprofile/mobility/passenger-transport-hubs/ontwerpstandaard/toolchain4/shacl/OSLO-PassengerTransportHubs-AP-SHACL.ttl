    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Mobiliteitsdienst.vervoermiddel>
  ], [
    a shacl:PropertyShape;
    rdfs:label "propulsion"@en;
    rdfs:comment "Propulsion of the means of transport with or for which the Mobility Service is usually organised."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/mobility/passenger-transport-hubs/ontwerpstandaard/toolchain4#Mobilityservice.Propulsion>;
