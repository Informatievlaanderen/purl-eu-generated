    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "startTime"@en;
    shacl:path <http://data.europa.eu/m8g/startTime>
  ], [
    a shacl:PropertyShape;
    rdfs:label "endTime"@en;
