    shacl:maxCount "1";
    shacl:name "meansOfTransport"@en;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Overstap.vervoermiddel>
  ], [
    a shacl:PropertyShape;
    rdfs:label "propulsion"@en;
    rdfs:comment "Propulsion of the means of transport by which the Transfer is made."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/mobility/passenger-transport-hubs/ontwerpstandaard/toolchain4#Transfer.Propulsion>;
    shacl:class skos:Concept;
    shacl:description "Propulsion of the means of transport by which the Transfer is made."@en;
    shacl:maxCount "1";
    shacl:name "propulsion"@en;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#propulsion>
  ], [
    a shacl:PropertyShape;
    rdfs:label "realisedAt"@en;
    <http://purl.org/vocab/vann/usageNote> "E.g. the stop where one changes between two metro lines, the address where one changes between two modes of transport."@en;
