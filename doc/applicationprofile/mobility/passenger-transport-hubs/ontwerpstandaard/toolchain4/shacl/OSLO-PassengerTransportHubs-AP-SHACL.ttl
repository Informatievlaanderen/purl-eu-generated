    rdfs:comment "Availability of the Mobility Service."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/mobility/passenger-transport-hubs/ontwerpstandaard/toolchain4#Mobilityservice.Availability>;
    shacl:class <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Availability>;
