    rdfs:label "capacity"@en;
    rdfs:comment "The capacity of the parking facility."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/mobility/passenger-transport-hubs/ontwerpstandaard/toolchain4#Parkingfacility.Capacity>;
