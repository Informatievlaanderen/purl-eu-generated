<https://purl.eu/doc/applicationprofile/mobility/passenger-transport-hubs/ontwerpstandaard/toolchain4#AddressrepresentationShape> a shacl:NodeShape;
  rdfs:label "AddressRepresentation"@en;
  rdfs:comment "More readable representation with only the basic data of the address, intended to use an address as attribute of another object."@en;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "houseNumber"@en;
    rdfs:comment "Alphanumeric code officially assigned to building units, moorings, standing places or parcels."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/mobility/passenger-transport-hubs/ontwerpstandaard/toolchain4#Addressrepresentation.Housenumber>;
    shacl:datatype xsd:string;
    shacl:description "Alphanumeric code officially assigned to building units, moorings, standing places or parcels."@en;
    shacl:maxCount "1";
