    shacl:name "provider"@en;
    shacl:path <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#provider>
  ], [
    a shacl:PropertyShape;
    rdfs:label "performedBy"@en;
    <http://purl.org/vocab/vann/usageNote> "May differ from the Provider."@en;
    rdfs:comment "Executor of the Mobility Service."@en;
    rdfs:seeAlso <https://purl.eu/doc/applicationprofile/mobility/passenger-transport-hubs/ontwerpstandaard/toolchain4#Mobilityservice.Performedby>;
    shacl:class <https://data.vlaanderen.be/ns/mobiliteit/trips-en-aanbod#Executor>;
    shacl:description "Executor of the Mobility Service."@en;
    shacl:minCount "1";
