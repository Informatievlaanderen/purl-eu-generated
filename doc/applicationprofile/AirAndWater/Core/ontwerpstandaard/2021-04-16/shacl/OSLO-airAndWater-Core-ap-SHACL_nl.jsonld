    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "De tijd tussen een (stapsgewijze) verandering in de waarde van een waargenomen ObservableProperty en een Sensor (eventueel met gespecificeerde fout) die zich 'vestigt' op een waargenomen waarde, onder de gedefinieerde Voorwaarden."
      }
    ],
