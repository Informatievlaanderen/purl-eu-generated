    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "Bijv. de temperatuur in verschillende meetstations. Resultaat is van het type DiscreetTimeInstantCoverage. Voor een meer gedetailleerde beschrijving van deze klasse zie ISO 19156."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
