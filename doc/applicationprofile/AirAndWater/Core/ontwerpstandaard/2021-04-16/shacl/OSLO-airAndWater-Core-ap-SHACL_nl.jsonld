  {
    "@id": "https://purl.eu/doc/applicationprofile/AirAndWater/Core/ontwerpstandaard/2021-04-16#SensorShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "Sensoren reageren op een stimulus, bijvoorbeeld een verandering in de omgeving, of invoergegevens die zijn samengesteld uit de resultaten van eerdere waarnemingen, en genereren een resultaat. Sensoren kunnen worden gehost door platforms. Voorbeelden: versnellingsmeters, gyroscopen, barameters, magnetometers enz., meestal gemonteerd op een smartphone (die fungeert als platform). Andere voorbeelden zijn de menselijke ogen."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Apparaat, agent (inclusief mensen) of software (simulatie) die betrokken is bij of uitvoering geeft aan een procedure om een observatie uit te voeren."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "Sensor"
      }
    ],
    "http://www.w3.org/ns/shacl#closed": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#boolean",
        "@value": "false"
      }
    ],
