      {
        "@language": "nl",
        "@value": "Meestal het moment waarop wordt geobserveerd of bemonsterd. Als de Waarneming tijdelijk is en het moment waarop iets plaatsvindt wordt geregistreerd, dan is dit ook het verschijnsel tijd."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Phenomenon time describes the time that the result applies to the property of the feature of interest. This is often the time of interaction by a sampling procedure or observation procedure with a real-world feature."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "phenomenonTime"
