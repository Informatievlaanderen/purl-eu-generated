    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Selectiviteit is een eigenschap van een sensor waarbij deze waargenomen waarden levert voor een of meer waarneembareeigenschappen, zodat het resultaat voor elke waarneembare eigenschap onafhankelijk is van andere eigenschappen in de onderzochte functie, onder de gedefinieerde voorwaarden."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "Selectiviteit"
      }
