  {
    "@id": "_:df_8_18",
    "@type": [
      "http://www.w3.org/ns/shacl#PropertyShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "Het gaat hier om gegevens die specifiek zijn voor de Observatie en complementair zijn aan de beschrijving van de tijdens de Observatie gevolgde procedure (analysemethode en aloke, zie Procesklasse), wat op zich al iets zegt over de kwaliteit van het resultaat."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "The resultQuality describes the quality of the result. This instance-specific description complements the description of the observation procedure, which provides information concerning the quality of all observations using this procedure. Quality of a result may be assessed following the procedures in ISO 19114:2003."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "resultQuality"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://purl.eu/doc/applicationprofile/AirAndWater/Core/ontwerpstandaard/2021-04-16#Observatie.Resultquality"
      }
    ],
    "http://www.w3.org/ns/shacl#class": [
      {
        "@id": "http://def.isotc211.org/iso19115/2006/DataQualityInformation#DQ_Element"
      }
    ],
    "http://www.w3.org/ns/shacl#description": [
      {
        "@language": "nl",
        "@value": "The resultQuality describes the quality of the result. This instance-specific description complements the description of the observation procedure, which provides information concerning the quality of all observations using this procedure. Quality of a result may be assessed following the procedures in ISO 19114:2003."
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "nl",
        "@value": "resultQuality"
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "http://def.isotc211.org/iso19156/2011/Observation#OM_Observation.resultQuality"
      }
    ]
  },
  {
    "@id": "_:df_8_19",
    "@type": [
      "http://www.w3.org/ns/shacl#PropertyShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "Het gaat hier niet om eigenschappen van de featureOfInterest (deze worden al beschreven door de observedProperty) of parameters die verband houden met het observatieproces (zoals een instrumentinstelling). Het gaat hier eerder om bijvoorbeeld omgevingsparameters die het resultaat kunnen beïnvloeden en belangrijk zijn voor het correct interpreteren van het resultaat. Een voorbeeld is de diepte in een put waar de waterkwaliteit is gemeten of de omgevingstemperatuur waarop de luchtvochtigheid is gemeten."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "The parameter describes an arbitrary event-specific parameter. This might be an environmental parameter, an instrument setting or input, or an event-specific sampling parameter that is not tightly bound to either the feature of interest or to the observation procedure."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "parameter"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://purl.eu/doc/applicationprofile/AirAndWater/Core/ontwerpstandaard/2021-04-16#Observatie.Parameter"
      }
    ],
    "http://www.w3.org/ns/shacl#class": [
      {
        "@id": "https://def.isotc211.org/iso19156/2011/Observation#NamedValue"
      }
    ],
    "http://www.w3.org/ns/shacl#description": [
      {
        "@language": "nl",
        "@value": "The parameter describes an arbitrary event-specific parameter. This might be an environmental parameter, an instrument setting or input, or an event-specific sampling parameter that is not tightly bound to either the feature of interest or to the observation procedure."
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "nl",
        "@value": "parameter"
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "http://def.isotc211.org/iso19156/2011/Observation#OM_Observation.parameter"
      }
    ]
  },
  {
    "@id": "_:df_8_2",
    "@type": [
      "http://www.w3.org/ns/shacl#PropertyShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "Is gelijk aan het fenomeen Tijd voor sommige Waarnemingen, maar kan ook verschillend zijn, bv. bij het uitvoeren van een analyse op een Sample die eerder (en meestal elders) genomen is of bij Sensormetingen die later verwerkt werden. Ook nuttig voor het scheiden van herhaalde waarnemingen, bijvoorbeeld op hetzelfde exemplaar. Als het resultaat een voorspelling is, dan is de fenomeenTijd het moment waarop het van toepassing zou moeten zijn."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "The resultTime describes the time when the result became available, typically when the procedure associated wit hthe observation was completed. For some observations this is identical to the phenomenonTime. Howevere there are important cases where they differ."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "resultTime"
      }
    ],
