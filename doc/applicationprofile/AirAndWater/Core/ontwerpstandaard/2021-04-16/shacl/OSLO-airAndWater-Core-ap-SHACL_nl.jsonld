  {
    "@id": "_:df_8_71",
    "@type": [
      "http://www.w3.org/ns/shacl#PropertyShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "Soms is de manier waarop de waarden van het onroerend goed worden verkregen indirect, d.w.z. men meet om praktische redenen een andere eigenschap die een proxy is voor de eigenschap die men echt wil observeren. En als die proxy geen eigenschap is van de featureOfInterest, dan vindt de Observatie plaats op een proxy van het Object. Om bijvoorbeeld de vegetatie in een gebied te achterhalen, meten we de kleurreflectie van het aardoppervlak. BEPERKING: De observed Property moet een actueel kenmerk zijn van het observed Object."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Relation linking an Observation to the property that was observed. The ObservableProperty should be a property of the FeatureOfInterest (linked by hasFeatureOfInterest) of this Observation."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "observedProperty"
      }
    ],
