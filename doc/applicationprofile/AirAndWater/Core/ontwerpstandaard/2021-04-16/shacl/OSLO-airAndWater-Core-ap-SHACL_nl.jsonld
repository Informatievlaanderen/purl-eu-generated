    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "Het gaat om een relatie die belangrijk is om het resultaat van een individuele waarneming te begrijpen, bv. een biotische relatie (dier A is een roofdier en is aanwezig omdat dier B als prooi voorkomt). Dergelijke relaties moeten expliciet worden beschreven (in tegenstelling tot relaties als het samenvallen van resultaten van waarnemingen in ruimte en tijd, die impliciet mogen blijven). Ook nuttig voor relaties waarbij de output van Observatie A de input is voor Observatie B."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Observations of which the results are related in one way or another"
