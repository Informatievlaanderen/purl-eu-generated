        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:403086cb829575dabbefa67fd22633df63bc91ab2ba5501c5b98c54b80fa7af1",
      "@type": "Class",
      "assignedURI": "https://purl.eu/ns/mobility/timetables-and-planning#GroupOfLines",
      "diagramLabel": [
        {
          "@value": "GroupOfLines"
        }
      ],
      "parent": [
        {
          "@id": "urn:oslo-toolchain:d4e6302d5e0d01afd00c1d6c4e9c9bf6b3c63b0f6861f9f66fde45c67a1870ff"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "vocDefinition": [
        {
          "@language": "en",
          "@value": "Group of Lines can be used to define several kinds of PT networks and sub-networks: what is usually called a ‘public transport network’ is in fact only a specific GroupOfLines and a Line may belong to several of them."
        },
        {
          "@language": "nl",
          "@value": "Groepen van Lijnen kunnen worden gebruikt om verschillende soorten OV netwerken en sub-netwerken te definiëren: Wat meestal een ‘openbaar vervoer netwerk’ wordt genoemd is in feite een specifieke Groep van Lijnen en een Lijn kan tot verschillende van hen behoren."
        },
        {
          "@language": "nl",
          "@value": "Groepen van Lijnen kunnen worden gebruikt om verschillende soorten OV netwerken en sub-netwerken te definiëren: Wat meestal een ‘openbaar vervoer netwerk’ wordt genoemd is in feite een specifieke Groep van Lijnen en een Lijn kan tot verschillende van hen behoren."
        }
      ],
      "vocLabel": [
        {
          "@language": "en",
          "@value": "Group of Lines"
        },
        {
          "@language": "nl",
          "@value": "Groep van Lijnen"
        },
        {
          "@language": "nl",
          "@value": "Groep van Lijnen"
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:2cbfde18fb069702a15228473e6982c0d968610f604ca11163e34d000a0a67d9",
      "@type": "Class",
      "assignedURI": "https://purl.eu/ns/mobility/timetables-and-planning#Line",
