    {
      "@id": "urn:oslo-toolchain:e3035b5afd549abe2da6215774f2828c6c26a8f71e7791a1edd1bbd45f41f617",
      "@type": "Datatype",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een 0-dimensioneel geometrisch object dat een bepaalde locatie in een coördinaatruimte voorstelt. Heeft een x-coördinaat en een y-coördinaat. Kan ook een z-coördinaat (hoogte) en een m-coördinaat (afstand langs een curve) hebben."
        }
      ],
      "assignedURI": "http://www.opengis.net/ont/sf#Point",
      "diagramLabel": [
        {
          "@value": "Point2"
        }
      ],
      "parent": [
        {
          "@id": "urn:oslo-toolchain:6ac7da3b1e6ee563c683bb20e6be52d1f1e5bc12fc4d6e050a106d4e74ea6997"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "vocDefinition": [
        {
          "@language": "en",
          "@value": "A 0-dimensional geometric object that represents a particular location in a coordinate space. Has an x coordinate and a y coordinate. Can also have a z coordinate (height) and an m coordinate (distance along a curve)."
        },
        {
          "@language": "nl",
          "@value": "Enter your translation here"
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Punt (Datatype)"
        },
        {
          "@language": "en",
          "@value": "Point (Datatype)"
        },
        {
          "@language": "nl",
          "@value": "Punt (Datatype)"
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:ee633a7383e28785aa0f9bb49e1b471053bba571f42194099742d7a25420ece4",
      "@type": "Datatype",
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Datatype kan een URI zijn of een GetypeerdeString. In het eerste geval wordt verwezen naar op het web gepubliceerde eenheden, bij voorkeur deze van qudt, bv http://qudt.org/vocab/unit/M voor meter. In het geval van een  GetypeerdeString gaat de voorkeur naar de UCUM-codes, bv \"km/h\"^^http://w3id.org/lindt/custom_datatypes#ucumunit."
        },
        {
          "@language": "en",
          "@value": "Datatype can be a URI or a TypedString. In the first case, reference is made to units published on the web, preferably those from qudt, eg http://qudt.org/vocab/unit/M for meter. In the case of a TypedString, preference is given to the UCUM codes, eg \"km/h\"^^http://w3id.org/lindt/custom_datatypes#ucumunit."
        },
        {
          "@language": "nl",
          "@value": "Datatype kan een URI zijn of een GetypeerdeString. In het eerste geval wordt verwezen naar op het web gepubliceerde eenheden, bij voorkeur deze van qudt, bv http://qudt.org/vocab/unit/M voor meter. In het geval van een  GetypeerdeString gaat de voorkeur naar de UCUM-codes, bv \"km/h\"^^http://w3id.org/lindt/custom_datatypes#ucumunit."
        }
      ],
      "assignedURI": "https://schema.org/unitCode",
      "diagramLabel": [
        {
          "@value": "StandardUnit"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Eenheid vastgelegd door een standaardiserende organisatie."
        },
