      "@type": "Datatype",
      "apDefinition": [
        {
          "@language": "en",
          "@value": "Surface consisting of 1 outer boundary and 0 or more inner boundaries. Each inner boundary forms a hole in the polygon."
        },
        {
          "@language": "nl",
          "@value": "Oppervlak bestaande uit 1 buitengrens en 0 of meer binnengrenzen. Elke binnengrens vormt een gat in de polygoon."
        },
        {
          "@language": "nl",
          "@value": "Oppervlak bestaande uit 1 buitengrens en 0 of meer binnengrenzen. Elke binnengrens vormt een gat in de polygoon."
        }
      ],
      "apUsageNote": [
        {
          "@language": "en",
          "@value": "The boundaries are so-called linear rings, that is, they are closed (non-self-intersecting) LineStrings. The outer boundary is distinguished from the inner boundary by the clockwise and counterclockwise directions in which the ring runs."
        },
        {
          "@language": "nl",
          "@value": "De grenzen zijn zgn lineaire ringen,ttz het zijn gesloten (niet zelfsnijdende) lijnstringen. De buitengrens wordt onderscheiden vd binnengrens door resp de kloksgewijze en tegenkloksgewijze richting waarin de ring loopt."
        },
        {
          "@language": "nl",
          "@value": "De grenzen zijn zgn lineaire ringen,ttz het zijn gesloten (niet zelfsnijdende) lijnstringen. De buitengrens wordt onderscheiden vd binnengrens door resp de kloksgewijze en tegenkloksgewijze richting waarin de ring loopt."
        }
      ],
