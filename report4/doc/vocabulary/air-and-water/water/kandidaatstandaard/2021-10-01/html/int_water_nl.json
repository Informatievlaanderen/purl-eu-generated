        "nl": "BioIndicatorObservation"
      },
      "applicationProfileLabel": {
        "nl": "BioIndicatorObservation"
      },
      "vocabularyDefinition": {
        "nl": "Observation that assesses the biological Quality of Water based on the overall condition of indicator species."
      },
      "applicationProfileDefinition": {
        "nl": "Observation that assesses the biological Quality of Water based on the overall condition of indicator species."
      },
      "vocabularyUsageNote": {
        "nl": "These species, also called BioIndicators, are living organisms such as plants, planktons, animals, microbes etc. More specifically, biochemical, physiological, behavioural or population changes are monitored."
