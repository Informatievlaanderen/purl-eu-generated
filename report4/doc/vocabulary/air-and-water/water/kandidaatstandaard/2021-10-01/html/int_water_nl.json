    {
      "id": "https://purl.eu/ns/air-and-water/water#BioticIndexObservation",
      "vocabularyLabel": {
        "nl": "BioticIndexObservation"
      },
      "applicationProfileLabel": {
        "nl": "BioticIndexObservation"
      },
      "vocabularyDefinition": {
        "nl": "Observation that assesses the biological Quality of Water on a certain scale based on what organisms are present in the Water and in what quantities."
      },
      "applicationProfileDefinition": {
        "nl": "Observation that assesses the biological Quality of Water on a certain scale based on what organisms are present in the Water and in what quantities."
      },
      "vocabularyUsageNote": {
        "nl": "In practice this comes down to counting specimens of certain species of macro-invertebrates like worms, snails, flies, clams etc present in the Water, weighted by the extent to which they tolerate Water pollution and combined into a single WaterqQuality score."
      },
      "applicationProfileUsageNote": {
        "nl": "In practice this comes down to counting specimens of certain species of macro-invertebrates like worms, snails, flies, clams etc present in the Water, weighted by the extent to which they tolerate Water pollution and combined into a single WaterqQuality score."
      },
