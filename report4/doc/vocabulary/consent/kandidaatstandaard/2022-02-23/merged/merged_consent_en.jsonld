    {
      "@id": "urn:oslo-toolchain:6811c868778f3a10bdcf7668f0a3e72c910684fcc58769777650768d1dd9d1b2",
      "@type": "Class",
      "assignedURI": "https://w3id.org/dpv/dpv-owl#DataProcessor",
      "apLabel": [
        {
          "@language": "en",
          "@value": "DataProcessor"
        }
      ],
      "diagramLabel": [
        {
          "@value": "DataProcessor"
        }
      ],
      "apDefinition": [
        {
          "@language": "en",
          "@value": "A 'processor' means a natural or legal person, public authority, agency or other body which processes personal data on behalf of the DataController."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
