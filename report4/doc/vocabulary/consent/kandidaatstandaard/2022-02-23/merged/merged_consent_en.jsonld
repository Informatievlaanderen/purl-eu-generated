    },
    {
      "@id": "urn:oslo-toolchain:51291fd0dd1311fb496452cdab92c53db65bdca116940add5315b1aa6a0c909a",
      "@type": "Class",
      "assignedURI": "https://w3id.org/dpv/dpv-owl#ConsentNotice",
      "apLabel": [
        {
          "@language": "en",
          "@value": "ConsentNotice"
        }
      ],
      "diagramLabel": [
        {
          "@value": "ConsentNotice"
        }
      ],
      "apDefinition": [
        {
          "@language": "en",
          "@value": "A Notice for information provision associated with a Consent."
        }
      ],
      "apUsageNote": [
        {
          "@language": "en",
          "@value": "This is to inform the Data Subject before his Consent can be obtained. To be substituted by a String, URL or Document referencing the actual Notice."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:7fb907f2b6a4369b2aaa9af6e66b592f3ece0dfaa8ff3a37e942a9716e13110c",
      "@type": "Class",
      "assignedURI": "https://w3id.org/dpv/dpv-owl#LegalBasis",
      "apLabel": [
        {
          "@language": "en",
          "@value": "LegalBasis"
        }
      ],
      "diagramLabel": [
        {
          "@value": "LegalBasis"
        }
      ],
      "apDefinition": [
        {
          "@language": "en",
          "@value": "The legal basis used to justify the Processing of the PersonalData."
        }
      ],
      "apUsageNote": [
        {
          "@language": "en",
          "@value": "REMARK: This profile focusses on one kind of Legal Basis, namely Consent. REMARK: DPV provides the possiblity to use LegalBasis as a category, eg the LegalBasis of PersonalDataHandling123 is Consent."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:f04b6ac3d5e4954ea27403f9939ef74ce57d3b7de2d7999cfe4cdceaf804d93b",
      "@type": "Class",
      "assignedURI": "https://w3id.org/dpv/dpv-owl#PersonalData",
      "apLabel": [
        {
          "@language": "en",
          "@value": "PersonalData"
        }
      ],
      "diagramLabel": [
        {
          "@value": "PersonalData"
        }
      ],
      "apDefinition": [
        {
          "@language": "en",
          "@value": "Data directly or indirectly associated or related to an individual."
        }
      ],
      "apUsageNote": [
        {
          "@language": "en",
          "@value": "This definition of personal data encompasses the concepts used in GDPR Art.4-1 for 'personal data' and ISO/IEC 2700 for 'personally identifiable information (PII)'."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:2b551e79f027c9792cde7c0728c4437505f002def89f063d4069ed4d17e778de",
      "@type": "Class",
      "assignedURI": "https://w3id.org/dpv/dpv-owl#LegalEntity",
      "apLabel": [
        {
          "@language": "en",
          "@value": "LegalEntity"
        }
      ],
      "diagramLabel": [
        {
          "@value": "LegalEntity"
        }
      ],
      "apDefinition": [
        {
          "@language": "en",
          "@value": "A human or non-human 'thing' that constitutes as an entity and which is recognised and defined in law."
        }
      ],
      "apUsageNote": [
        {
          "@language": "en",
          "@value": "Superclass of entities like Data Subject, DataController etc, ie roles with legal importance in the GDPR."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:459eac153540d69f4ec69b0f10b0a62c70e760b02b5a8f09b66b5dbed0ef8998"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:459eac153540d69f4ec69b0f10b0a62c70e760b02b5a8f09b66b5dbed0ef8998",
      "@type": "Class",
      "assignedURI": "https://w3id.org/dpv/dpv-owl#Entity",
      "apLabel": [
        {
          "@language": "en",
          "@value": "Entity"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Entity"
        }
      ],
      "apDefinition": [
        {
          "@language": "en",
          "@value": "A human or non-human 'thing' that constitutes as an entity."
        }
      ],
      "apUsageNote": [
        {
          "@language": "en",
          "@value": "To be used as an abstract superclass and to be substituted by an Agent like a Person or Organisation and/or a LegalEntity like a DataSubject, DataController etc."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:e0a7531bc062ea6701720cc3b71f630f543202b46cc6ef81cbfeca2d772c6d8d",
      "@type": "Class",
      "assignedURI": "https://w3id.org/dpv/dpv-owl#Risk",
      "apLabel": [
        {
          "@language": "en",
          "@value": "Risk"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Risk"
        }
      ],
      "apDefinition": [
        {
          "@language": "en",
          "@value": "A risk or possibility or uncertainty of negative effects, impacts, or consequences."
        }
      ],
      "apUsageNote": [
        {
          "@language": "en",
          "@value": "Risks can be associated with one or more different concepts such as Purpose, Processing, PersonalData, TechnicalOrganisationalMeasures. REMARK: More info on this class in <a href=\"https://w3c.github.io/dpv/risk/\">DPV-Risk</a>."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:bc821dc38c72dd40d34af963ff2dc8d9fb3de36aebb25e65305a125f28133ebc",
      "@type": "Class",
      "assignedURI": "https://w3id.org/dpv/dpv-owl#Right",
      "apLabel": [
        {
          "@language": "en",
          "@value": "Right"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Right"
        }
      ],
      "apDefinition": [
        {
          "@language": "en",
          "@value": "The right(s) applicable, provided, or expected."
        }
      ],
      "apUsageNote": [
        {
          "@language": "en",
          "@value": "A 'right' is a legal, social, or ethical principle of freedom or entitlement which dictates the norms regarding what is allowed or owed. Rights as a concept encompass a broad area of norms and entities, and are not specific to individuals or Data Protection / Privacy. REMARK: For individual specific rights, see DPV:DataSubjectRight and <a href=\"https://w3c.github.io/dpv/rights/eu/\">EU Fundamental Rights</a>."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:a4cc4131a8b06faf059159df6f148b0858a1ab98f547b9f2251305ca54da3428",
