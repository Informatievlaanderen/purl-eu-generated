          "@language": "en",
          "@value": "creation time"
        },
        {
          "@language": "nl",
          "@value": "Enter your translation here"
        }
      ],
      "vocUsageNote": [
        {
          "@language": "en",
          "@value": "This moment changes whenever the status of the consent is being updated. For example, when a data controller requests a consent a consent will be made with the creation time being equal with the moment of the request. When later on the data subject gives consent a new consent will be made with a new status (e.g. explicitlyGiven) and the creation time of this consent will be equal to the moment in which the data subject has granted consent."
        },
        {
          "@language": "nl",
          "@value": "Enter your translation here"
        }
      ]
    },
