    {
      "@id": "urn:oslo-toolchain:ad4eabdc181d123d6690950992813169cb5aa478f31c94f5cc536967bfe7f4be",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Transport node that is dynamically created."
        },
        {
          "@language": "en",
          "@value": "Transport node that is dynamically created."
        },
        {
          "@language": "nl",
          "@value": "Transport node that is dynamically created."
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "VirtualNode"
        },
        {
          "@language": "en",
          "@value": "VirtualNode"
        },
        {
          "@language": "nl",
          "@value": "VirtualNode"
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "The place where a Trip is started usually does not coincide with an existing Transport node, for example it is the home of the Traveller located between two intersections. To still enter the network to start his Trip, the Traveller creates a Virtual Node on the link between these intersections. Virtual Nodes are important for a correct estimation of the travel time e.g. for route planning because the distance between the Virtual Node and the next real Transport Node must be added. Also important for example in free-floating partial transport where the position of the partial step does not necessarily coincide with that of an existing Transport Node."
        },
        {
          "@language": "en",
          "@value": "The place where a Trip is started usually does not coincide with an existing Transport node, for example it is the home of the Traveller located between two intersections. To still enter the network to start his Trip, the Traveller creates a Virtual Node on the link between these intersections. Virtual Nodes are important for a correct estimation of the travel time e.g. for route planning because the distance between the Virtual Node and the next real Transport Node must be added. Also important for example in free-floating partial transport where the position of the partial step does not necessarily coincide with that of an existing Transport Node."
        },
        {
          "@language": "nl",
          "@value": "The place where a Trip is started usually does not coincide with an existing Transport node, for example it is the home of the Traveller located between two intersections. To still enter the network to start his Trip, the Traveller creates a Virtual Node on the link between these intersections. Virtual Nodes are important for a correct estimation of the travel time e.g. for route planning because the distance between the Virtual Node and the next real Transport Node must be added. Also important for example in free-floating partial transport where the position of the partial step does not necessarily coincide with that of an existing Transport Node."
        }
      ],
      "assignedURI": "https://purl.eu/ns/mobility/passenger-transport-hubs#VirtualNode",
      "diagramLabel": [
        {
          "@value": "VirtualNode"
        }
      ],
