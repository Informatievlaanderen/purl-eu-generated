  "datatypes": [
    {
      "@id": "urn:oslo-toolchain:f54061dfdcc5fcdfc09bfda4d87ffb754ebac81acc1209c8bf43bb01098aa82e",
      "@type": "Datatype",
      "assignedURI": "http://www.opengis.net/ont/sf#Point",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Punt (Datatype)"
        },
        {
          "@language": "en",
          "@value": "Point (Datatype)"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Point2"
        }
      ],
      "vocDefinition": [
        {
          "@language": "en",
          "@value": "A 0-dimensional geometric object that represents a particular location in a coordinate space. Has an x coordinate and a y coordinate. Can also have a z coordinate (height) and an m coordinate (distance along a curve)."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een 0-dimensioneel geometrisch object dat een bepaalde locatie in een coördinaatruimte voorstelt. Heeft een x-coördinaat en een y-coördinaat. Kan ook een z-coördinaat (hoogte) en een m-coördinaat (afstand langs een curve) hebben."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:6cf17a7c4afbe7b9de46fbf9dc4a48ed40a1beefa3d860d94b0046a32c0d38ac"
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:6cf17a7c4afbe7b9de46fbf9dc4a48ed40a1beefa3d860d94b0046a32c0d38ac",
      "@type": "Datatype",
      "assignedURI": "http://www.w3.org/ns/locn#Geometry",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Geometrie"
        },
        {
          "@language": "en",
          "@value": "Geometry"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Geometry"
        }
      ],
      "vocDefinition": [
        {
          "@language": "en",
          "@value": "Shape and position characteristics of an object."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Vorm- en positiekenmerken van een object."
        }
      ],
      "apUsageNote": [
        {
          "@language": "en",
          "@value": "Describes these features using points, lines, polygons, and coordinates."
        },
        {
          "@language": "nl",
          "@value": "Beschrijft deze kenmerken dmv punten, lijnen, polygonen en coördinaten."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External"
    },
    {
      "@id": "urn:oslo-toolchain:7f85e04e6c06e79d92db308a23c0e3a6c8560608069fb30a1f7b77dcfeae786d",
      "@type": "Datatype",
      "assignedURI": "http://www.opengis.net/ont/sf#Polygon",
      "vocLabel": [
        {
          "@language": "en",
          "@value": "Polygon"
        },
        {
          "@language": "nl",
          "@value": "Polygoon"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Polygon"
        }
      ],
      "vocDefinition": [
        {
          "@language": "en",
          "@value": "Surface consisting of 1 outer boundary and 0 or more inner boundaries. Each inner boundary forms a hole in the polygon."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Oppervlak bestaande uit 1 buitengrens en 0 of meer binnengrenzen. Elke binnengrens vormt een gat in de polygoon."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "De grenzen zijn zgn lineaire ringen,ttz het zijn gesloten (niet zelfsnijdende) lijnstringen. De buitengrens wordt onderscheiden vd binnengrens door resp de kloksgewijze en tegenkloksgewijze richting waarin de ring loopt."
        },
        {
          "@language": "en",
          "@value": "The boundaries are so-called LinearRings, ie they are closed (not self-intersecting) LineStrings. The outer boundary is distinguished from the inner boundary by the clockwise and counterclockwise direction of the ring, respectively."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:6cf17a7c4afbe7b9de46fbf9dc4a48ed40a1beefa3d860d94b0046a32c0d38ac"
        }
      ]
    },
