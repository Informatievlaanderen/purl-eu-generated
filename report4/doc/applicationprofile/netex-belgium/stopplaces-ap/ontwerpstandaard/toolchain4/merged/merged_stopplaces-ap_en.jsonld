        {
          "@language": "nl",
          "@value": "Bepaalt een uniforme reeks waarden om de verschijningen van een element te controleren (op een kaart, een schematische kaart, een papier- of schermbeschrijving, enz.)."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage"
