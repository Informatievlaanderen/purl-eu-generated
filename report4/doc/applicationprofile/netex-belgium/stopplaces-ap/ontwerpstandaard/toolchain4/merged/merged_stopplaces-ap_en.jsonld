        },
        {
          "@language": "nl",
          "@value": "Sitecomponent"
        }
      ],
      "diagramLabel": [
        {
          "@value": "SiteComponent"
        }
      ],
      "vocDefinition": [
        {
          "@language": "en",
          "@value": "A component of a Site describing a part of its structure. Shares common properties for equipment, management, accessibility and other features."
        },
        {
          "@language": "nl",
          "@value": "Een component van een Site die een deel van de structuur ervan beschrijft. Deelt gemeenschappelijke eigenschappen voor apparatuur, beheer, toegankelijkheid en andere functies."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage"
    },
    {
      "@id": "urn:oslo-toolchain:e586d89a5ec4544e58c268ea954908463b8ede6a0392289dd3f638bcb40a636b",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/ns/org#FormalOrganization",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Formele Organisatie"
        },
        {
          "@language": "en",
          "@value": "Formal Organization"
        }
      ],
      "diagramLabel": [
        {
          "@value": "FormalOrganization"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een erkende organisatie, erkend in brede zin of  meer specifiek in juridische zin met bijbehorende rechten en plichten."
        },
        {
          "@language": "en",
          "@value": "A recognized organization, recognized in a broad sense or more specifically in a legal sense, with associated rights and obligations."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Bvb een bedrijf,een vzw,een overheidsorgaan,een kerkgemeenschap."
        },
        {
          "@language": "en",
          "@value": "Eg a company, a non-profit organization, a government body, a church community."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:b11f1a7b4a131cd67b1ff00df61084ac73c581ef07c9ebf0c7f59c28bb527f81"
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:a8a679776bc616689d44c9d2dfb474e35df216286a17235e1a582a35008a43ff",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/2004/02/skos/core#Concept",
      "diagramLabel": [
        {
          "@value": "OrganizationType"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Type of Organization."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External"
    },
    {
      "@id": "urn:oslo-toolchain:283e0f14cc06f0112847270ad948726b83fe2c63a2479c451967f4c82b49ed31",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/ns/regorg#RegisteredOrganization",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Geregistreerde Organisatie"
        },
        {
          "@language": "en",
          "@value": "Registered Organization"
        }
      ],
      "diagramLabel": [
        {
          "@value": "RegisteredOrganization"
        }
      ],
      "vocDefinition": [
        {
          "@language": "en",
          "@value": "Organization with a legal status established by registration. This is more specific than a Formal Organization where this status can also be obtained in another way."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Organisatie met een juridisch statuut vastgelegd door registratie. Vergelijk met een formele organisatie waarbij dit statuut ook op een andere manier verkregen kan zijn."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "In België moeten oa volgende organisaties zich registreren: vennootschap (nv,bvba etc),eenmanszaak,overheidsorgaan,stichting… Bij registratie krijgt de organisatie een ondernemingsnummer en worden zijn gegevens ingevoerd in de KBO."
        },
        {
          "@language": "en",
          "@value": "In Belgium, like in many other countries, the following kinds Organizations must register: company, sole proprietorship, government body, foundation… Upon registration, the Organization receives a company number and its details are entered in a central registry called Crossrads Bank for Enterprises (CBE). More details on this class in the <a href=\"https://www.w3.org/TR/vocab-regorg/\">Registered Organization Vocabulary</a>."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:e586d89a5ec4544e58c268ea954908463b8ede6a0392289dd3f638bcb40a636b"
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:07d83ef5ecc027d5c741d6e6f52cd33954862daace87774067e5e1b23c37dfe9",
      "@type": "Class",
      "assignedURI": "https://purl.eu/ns/mobility/timetables-and-planning#Place",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Plaats"
        },
        {
          "@language": "en",
          "@value": "Place"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Place"
        }
      ],
      "vocDefinition": [
        {
          "@language": "en",
          "@value": "Topographically significant location that a transport model may wish to describe."
        },
        {
          "@language": "nl",
          "@value": "Topografisch belangrijke locatie,relevant genoeg voor eentransportmodel om te beschrijven."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage"
    },
    {
      "@id": "urn:oslo-toolchain:1ea866981a63a1d1e75598559d646c67a0bfb98f6fcca94d9594910979d70152",
      "@type": "Class",
      "assignedURI": "https://purl.eu/ns/mobility/timetables-and-planning#GroupOfEntities",
      "vocLabel": [
        {
          "@language": "en",
          "@value": "Group of Entities"
        },
        {
          "@language": "nl",
          "@value": "Groep van Entiteiten"
        }
      ],
      "diagramLabel": [
        {
          "@value": "GroupOfEntities"
        }
      ],
      "vocDefinition": [
        {
          "@language": "en",
          "@value": "A set of Entities grouped together according to a purpose of grouping, e.g. grouping of stops known to the public by a common name."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage"
    },
    {
      "@id": "urn:oslo-toolchain:b2e3e2982e5afa3bfd88f63a2e35a9e3dba0cfaa9e0c6e5b43d40710e11df1c4",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/adres#Adres",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Adres"
        },
        {
          "@language": "en",
          "@value": "Address"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Address"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Informatie die toelaat om in België op een gestructureerde en unieke manier te verwijzen naar een \"gebouweenheid\", \"gebouw\", een “ligplaats”, een “standplaats” of een “perceel” op basis van de naam van de “gemeente, de “straatnaam” en het “huisnummer” eventueel aangevuld met een “busnummer” en met een “postcode”."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Informatie die toelaat om op een gestructureerde en unieke manier te verwijzen naar een gebouweenheid,een ligplaats,een standplaats of een perceel op basis van een gemeentenaam,een straatnaam,een huisnummer en eventueel een busnummer en een postcode."
        },
        {
          "@language": "en",
          "@value": "Information that makes it possible to refer in a structured and unique way to a building unit, a berth, a location or a plot on the basis of a municipality name, a street name, a house number and possibly a bus number and a postal code."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "De definitie heeft betrekking op Belgische adressen. In andere landen kan een adres eventueel verwijzen naar andere geografisch objecten (niet gebouweenheid of perceel) of bestaan uit andere aanduidingen (verschillend van huisnummer en busnummer) of uit andere componenten dan straatnaam, gemeentenaam of postcode. Alternatieve adresaanduidingen dan huisnummer of busnummer (bv ingangaanduiding, trapaanduiding, verdiepaanduiding...) of een gebouwnaam of kamernaam ed zijn mogelijk dmv een associatie met adresuitbreiding. Uitwisseling van buitenlandse adressen moet gebeuren mbv het object adresvoorstelling."
        },
        {
          "@language": "en",
          "@value": "The definition refers to Belgian Addresses. In other countries, an Address may refer to other geographical objects (not a building unit or parcel) or may consist of other designations (different from house number and bus number) or of components other than street name, municipality name or postal code. Foreign addresses can be exchanged using the Address Representation object. More detail on this class in the <a href=\"https://inspire.ec.europa.eu/id/document/tg/ad\">INSPRE Address specification</a>."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External"
    },
