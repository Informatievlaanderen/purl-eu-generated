        }
      ],
      "diagramLabel": [
        {
          "@value": "AddressRepresentation"
        }
      ],
      "vocDefinition": [
        {
          "@language": "en",
          "@value": "More readable representation of a structured Address with only the basic or combined data, intended for the use of an address as an attribute of another object or as a label."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Beter leesbare weergave van een gestructureerd adres met alleen de basis- of gecombineerde gegevens, bedoeld voor het gebruik van een adres als attribuut van een ander object of als label."
        }
      ],
      "apUsageNote": [
        {
          "@language": "en",
          "@value": "Eg as an attribute of a person or building or as a label on a letter or a map."
        },
        {
          "@language": "nl",
          "@value": "Bijvoorbeeld als attribuut van een persoon of gebouw of als label op een brief of een plattegrond."
        }
      ],
