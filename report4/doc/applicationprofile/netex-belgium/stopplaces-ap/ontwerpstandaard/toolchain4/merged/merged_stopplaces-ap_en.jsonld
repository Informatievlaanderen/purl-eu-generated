      ],
      "vocDefinition": [
        {
          "@language": "en",
          "@value": "A Stop Place represents a station, stop, port, airport or any physical point of access to the transport network."
        },
        {
          "@language": "nl",
          "@value": "Een Stopplaats stelt een station, halte, haven, luchthaven of eender welk ander fysiek toegangspunt tot het transportnetwerk voor."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
