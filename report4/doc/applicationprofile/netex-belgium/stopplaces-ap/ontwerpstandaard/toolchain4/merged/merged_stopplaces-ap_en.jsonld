    {
      "@id": "urn:oslo-toolchain:3e1bb9328f1a0480d9d1b9e444bbd58d4f28d2e695dd4b6907b1295cfb0d88d2",
      "@type": "Class",
      "assignedURI": "https://purl.eu/ns/mobility/timetables-and-planning#SiteComponent",
