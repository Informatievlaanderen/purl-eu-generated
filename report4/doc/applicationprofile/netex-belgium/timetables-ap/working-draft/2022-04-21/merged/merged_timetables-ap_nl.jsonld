      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een alternatieve geoptimaliseerde weergave van een operationele periode die een reeks bits gebruikt om aan te geven aan welke dagen met de periode een specifiek daytype van toepassing is."
        },
        {
          "@language": "en",
          "@value": "An alternative optimised representation of an Operating Period that uses a string of bits to indicate to which days with the period a specific DayType applies."
        }
      ],
