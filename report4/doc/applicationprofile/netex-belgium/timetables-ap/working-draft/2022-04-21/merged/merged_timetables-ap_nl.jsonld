    {
      "@id": "urn:oslo-toolchain:e676b187eca6625ca361debcc0f7b1d219ca53ac0fe961e3f0166d129a5a270c",
      "@type": "Class",
      "assignedURI": "https://purl.eu/ns/mobility/timetables-and-planning#OperatingDay",
      "vocLabel": [
        {
          "@language": "en",
          "@value": "Operating Day"
        },
        {
          "@language": "nl",
          "@value": "Operationele Dag"
        }
      ],
      "diagramLabel": [
        {
          "@value": "OperatingDay"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een dag van openbaar vervoer waarvan de kenmerken worden gedefinieerd in een specifieke dienstkalender."
        },
        {
          "@language": "en",
          "@value": "A day of public transport operation of which the characteristics are defined within in a specific Service Calendar."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Een werkdag kan meer dan 24 uur duren."
        },
        {
          "@language": "en",
          "@value": "An Operating Day may last more than 24 hours."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage"
    },
    {
      "@id": "urn:oslo-toolchain:a1280c45f4ad3a485c38068ed302729219122b5b72977cdc555e9ea9666ad568",
