        },
        {
          "@language": "nl",
          "@value": "Tijdsband"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Timeband"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een periode op een dag, belangrijk voor een aspect van het openbaar vervoer, b.v. vergelijkbare verkeersvoorwaarden of fare categorie."
        },
        {
          "@language": "en",
          "@value": "A period in a day, significant for some aspect of public transport, e.g. similar traffic conditions or fare category."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage"
    },
