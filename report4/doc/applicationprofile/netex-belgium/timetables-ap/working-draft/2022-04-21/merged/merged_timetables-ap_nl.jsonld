      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "String of bits (gebouwd van \"0\" en \"1\"), één voor elke dag in de periode: al dan niet geldig of niet geldig op de dag."
        },
        {
          "@language": "en",
          "@value": "String of bits (built of \"0\" and \"1\"), one for each day in the period: whether valid or not valid on the day."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Normaal gesproken is er een beetje voor elke dag tussen start- en einddatum. Als bit ontbreekt, neem dan aan beschikbaar."
        },
        {
          "@language": "en",
          "@value": "Normally there will be a bit for every day between start and end date. If bit is missing, assume available."
        }
