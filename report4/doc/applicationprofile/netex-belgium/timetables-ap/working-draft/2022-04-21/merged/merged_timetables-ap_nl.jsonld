    {
      "@id": "urn:oslo-toolchain:2b65d6ba77ade42cdc4bee7f45c2a9eb4d143eb6de99d761f4ad39ebeaea9ede",
      "@type": "Class",
      "assignedURI": "https://purl.eu/ns/mobility/timetables-and-planning#VehicleType",
      "vocLabel": [
        {
          "@language": "en",
          "@value": "Vehicle Type"
        },
        {
          "@language": "nl",
          "@value": "Voertuigtype"
        }
      ],
      "diagramLabel": [
        {
          "@value": "VehicleType"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Voertuigen kunnen worden geclassificeerd met behulp van een voertuigtype volgens hoe zij voldoen aan de vereisten van voertuigplanning m.b.t. de capaciteit en het aan boord hebben van faciliteiten (bijvoorbeeld standaardbus, dubbeldek, enz.)."
        },
        {
          "@language": "en",
          "@value": "Vehicles may be classified using a Vehicle Type according to how they meet vehicle scheduling requirements as to capacity and on-board facilities (e.g. standard bus, double decker, etc.)."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage"
    },
    {
      "@id": "urn:oslo-toolchain:95d2b9d872de5fe7bfa799e20e66271aa61490b27037e29f83ef2f664288a1d8",
      "@type": "Class",
      "assignedURI": "https://purl.eu/ns/mobility/timetables-and-planning#DayType",
      "vocLabel": [
        {
          "@language": "en",
          "@value": "Day Type"
        },
        {
          "@language": "nl",
          "@value": "Dagtype"
        }
      ],
      "diagramLabel": [
        {
          "@value": "DayType"
        }
      ],
      "vocDefinition": [
        {
          "@language": "en",
          "@value": "A type of day characterised by one or more properties which affect public transport operation."
        },
        {
          "@language": "nl",
          "@value": "Een type dag gekenmerkt door een of meer eigenschappen die van invloed zijn op het openbaar vervoer."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "en",
          "@value": "For example: weekday in school holidays."
        },
        {
          "@language": "nl",
          "@value": "Bijvoorbeeld: weekdag in schoolvakanties."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage"
    },
