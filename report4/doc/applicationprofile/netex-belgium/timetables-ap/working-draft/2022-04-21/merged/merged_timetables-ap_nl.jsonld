    {
      "@id": "urn:oslo-toolchain:8693a77b079408481a5e176d463422536d22c94bcd3eb3565d05c232e60b7821",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/ns/org#FormalOrganization",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Formele Organisatie"
        },
        {
          "@language": "en",
          "@value": "Formal Organization"
        }
      ],
      "diagramLabel": [
        {
          "@value": "FormalOrganization"
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een erkende organisatie, erkend in brede zin of  meer specifiek in juridische zin met bijbehorende rechten en plichten."
        },
        {
          "@language": "en",
          "@value": "A recognized organization, recognized in a broad sense or more specifically in a legal sense, with associated rights and obligations."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Bvb een bedrijf,een vzw,een overheidsorgaan,een kerkgemeenschap."
        },
        {
          "@language": "en",
          "@value": "Eg a company, a non-profit organization, a government body, a church community."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:b2eacc8163e1ea4400c81a2f8124f682277bd286240e776f4bf212af03f80587"
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:b2eacc8163e1ea4400c81a2f8124f682277bd286240e776f4bf212af03f80587",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/ns/org#Organization",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Organisatie"
        },
        {
          "@language": "en",
          "@value": "Organization"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Organization"
        }
      ],
      "vocDefinition": [
        {
          "@language": "en",
          "@value": "A number of people organized into a community or other social, commercial, or political structure. The group has a common purpose or raison d'être that transcends its individual members and it can act as an agent. An organization often has a hierarchical structure."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Een aantal mensen georganiseerd in een gemeenschap of andere sociale, commerciële of politieke structuur. De groep heeft een gemeenschappelijk doel of bestaansreden die de individuele leden ervan overstijgt en kan handelen als agent. Een organisatie heeft dikwijls een hiërarchische structuur."
        }
      ],
      "apUsageNote": [
        {
          "@language": "en",
          "@value": "More details on this class in the <a href=\"https://w3.org/TR/vocab-org/\">W3C Organization Ontology</a>."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External"
    },
    {
      "@id": "urn:oslo-toolchain:b3bb601fb28f565871143f086ff8ea2ffae5fb9b864046f1adeafde7597edc2d",
      "@type": "Class",
      "assignedURI": "https://purl.eu/ns/mobility/timetables-and-planning#Timeband",
      "vocLabel": [
