          "@value": "HeadwayInterval"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een tijdsinterval of een duur die een voortgangsperiode definieert en het karakteriseren van de hiatus ritgroepen (bijvoorbeeld elke 10 minuten, elke 4-6 min)."
        },
        {
          "@language": "en",
          "@value": "A time interval or a duration defining a headway period and characterizing Headway Journey Groups (e.g. every 10 min, every 4-6 min)."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage"
    },
    {
