    {
      "@id": "urn:oslo-toolchain:b364f3afc1332fac7cff7d298af4abab0df2867ae85894e53b46faab26eb2d68",
      "@type": "Class",
      "assignedURI": "https://purl.eu/ns/mobility/timetables-and-planning#TrainNumber",
      "vocLabel": [
        {
          "@language": "en",
          "@value": "Train Number"
        },
        {
          "@language": "nl",
          "@value": "Treinnummer"
        }
      ],
      "diagramLabel": [
        {
          "@value": "TrainNumber"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Geeft de specificatie van codes die zijn toegewezen aan bepaalde voertuigreizen bij gebruik door treinen van samengestelde treinen volgens een functioneel doel (passagiersinformatie, follow-up, enz.)."
        },
        {
          "@language": "en",
          "@value": "Provides the specification of codes assigned to particular Vehicle Journeys when operated by Trains of Compound Trains according to a functional purpose (passenger information, operation follow-up, etc.)."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage"
    },
    {
      "@id": "urn:oslo-toolchain:5f5bbf6479389cad460e687b739c543811a8159a9c88fbb0fd00534bf1188aac",
      "@type": "Class",
      "assignedURI": "https://purl.eu/ns/mobility/timetables-and-planning#JourneyPart",
      "vocLabel": [
        {
          "@language": "en",
          "@value": "Journey Part"
        },
        {
          "@language": "nl",
          "@value": "Ritdeel"
        }
      ],
      "diagramLabel": [
        {
          "@value": "JourneyPart"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een deel van een voertuigrit gecreëerd volgens een specifiek functioneel doel, bijvoorbeeld in situaties wanneer het koppelen of scheiden van het voertuig optreedt."
        },
        {
          "@language": "en",
          "@value": "A part of a Vehicle Journey created according to a specific functional purpose, for instance in situations when vehicle coupling or separation occurs."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage"
    },
    {
      "@id": "urn:oslo-toolchain:1ed86057ff093e2ce749d7af988f3edc92fe2e1d6b4be4376cbe656d6959b798",
      "@type": "Class",
      "assignedURI": "https://purl.eu/ns/mobility/timetables-and-planning#ServiceFacilitySet",
      "vocLabel": [
        {
          "@language": "en",
          "@value": "Service Facility Set"
        },
        {
          "@language": "nl",
          "@value": "Dienst Faciliteitenset"
        }
      ],
      "diagramLabel": [
        {
          "@value": "ServiceFacilitySet"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Beschrijft de beschikbare faciliteiten aan boord van een dienst. Het biedt bovendien het type accommodatie (zitplaatsen, couchettes, enz.) Te beschrijven."
        },
        {
          "@language": "en",
          "@value": "Describes the Facilities available onboard a service. It additionally allows the type of Accommodation (seating, couchettes, etc.) to be described."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage"
    },
    {
