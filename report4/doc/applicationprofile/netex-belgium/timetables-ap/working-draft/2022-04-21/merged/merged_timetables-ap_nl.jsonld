  ],
  "classes": [
    {
      "@id": "urn:oslo-toolchain:dd46dddbd66a747d6035efe346c56e66a66d84733132a58aac9534addbcdf964",
      "@type": "Class",
      "assignedURI": "https://purl.eu/ns/mobility/timetables-and-planning#Network",
      "vocLabel": [
        {
          "@language": "en",
          "@value": "Network"
        },
        {
          "@language": "nl",
          "@value": "Netwerk"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Network"
        }
      ],
      "vocDefinition": [
        {
          "@language": "en",
          "@value": "A named grouping of Lines under which a Transport network is known."
        },
        {
          "@language": "nl",
          "@value": "Een benoemde groep van Lijnen waaronder een Transportnetwerk gekend is."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:403086cb829575dabbefa67fd22633df63bc91ab2ba5501c5b98c54b80fa7af1"
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:403086cb829575dabbefa67fd22633df63bc91ab2ba5501c5b98c54b80fa7af1",
      "@type": "Class",
      "assignedURI": "https://purl.eu/ns/mobility/timetables-and-planning#GroupOfLines",
      "vocLabel": [
        {
          "@language": "en",
          "@value": "Group of Lines"
        },
        {
          "@language": "nl",
          "@value": "Groep van Lijnen"
        }
      ],
      "diagramLabel": [
        {
          "@value": "GroupOfLines"
        }
      ],
      "vocDefinition": [
        {
          "@language": "en",
          "@value": "Group of Lines can be used to define several kinds of PT networks and sub-networks: what is usually called a ‘public transport network’ is in fact only a specific GroupOfLines and a Line may belong to several of them."
        },
        {
          "@language": "nl",
          "@value": "Groepen van Lijnen kunnen worden gebruikt om verschillende soorten OV netwerken en sub-netwerken te definiëren: Wat meestal een ‘openbaar vervoer netwerk’ wordt genoemd is in feite een specifieke Groep van Lijnen en een Lijn kan tot verschillende van hen behoren."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:d4e6302d5e0d01afd00c1d6c4e9c9bf6b3c63b0f6861f9f66fde45c67a1870ff"
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:2cbfde18fb069702a15228473e6982c0d968610f604ca11163e34d000a0a67d9",
      "@type": "Class",
      "assignedURI": "https://purl.eu/ns/mobility/timetables-and-planning#Line",
      "vocLabel": [
        {
          "@language": "en",
          "@value": "Line"
        },
        {
          "@language": "nl",
          "@value": "Lijn"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Line"
        }
      ],
      "vocDefinition": [
        {
          "@language": "en",
          "@value": "A grouping of Routes that is generally known to the public by a similar name or number."
        },
        {
          "@language": "nl",
          "@value": "Een groepering van Routes welke algemeen bekend zijn bij het brede publiek onder een gelijkaardige naam of nummer."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage"
    },
    {
      "@id": "urn:oslo-toolchain:52f20f03df4248dffaf38bccfa752a258cc53e97aa69146eb855726c31bdc2ed",
      "@type": "Class",
      "assignedURI": "https://purl.eu/ns/mobility/timetables-and-planning#Route",
      "vocLabel": [
        {
          "@language": "en",
          "@value": "Route"
        },
        {
          "@language": "nl",
          "@value": "Route"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Route"
        }
      ],
      "vocDefinition": [
        {
          "@language": "en",
          "@value": "Ordered list of located Points defining one single path through the road (or rail) Network. A Route may pass through the same Point more than once."
        },
        {
          "@language": "nl",
          "@value": "Een geordende lijst van gelokaliseerde Punten, welke een enkel pad doorheen een wegen- (of spoorwegen-) netwerk definiëren. Een Route kan meerdere keren doorheen hetzelfde Punt passeren."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:0ce7e0b4dde22b6b1e6f9594e1c6f817e3bb978d4728900fb3dd3a8b7b5394c5"
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:c227d527c99682a8310c5dc05b277e4bdb48c5491da04a923fb7962b9c1c0a8f",
      "@type": "Class",
      "assignedURI": "https://purl.eu/ns/mobility/timetables-and-planning#JourneyPattern",
      "vocLabel": [
        {
          "@language": "en",
          "@value": "Journey Pattern"
        },
        {
          "@language": "nl",
          "@value": "Ritpatroon"
        }
      ],
      "diagramLabel": [
        {
          "@value": "JourneyPattern"
        }
      ],
      "vocDefinition": [
        {
          "@language": "en",
          "@value": "An ordered list of Scheduled Stop Points and Timing Points on a single Route, describing the pattern of working for public transport vehicles. A Journey Pattern may pass through the same Point more than once."
        },
        {
          "@language": "nl",
          "@value": "Het Ritpatroon geeft een ruimtelijke beschrijving van de dienst, m.a.w. hoe deze ruimtelijk wordt uitgevoerd. Waar Routes en Lijnen het pad weergeven dat in het netwerk wordt gevolgd, zegt het Ritpatroon hoe deze paden worden uitgevoerd. Als het om een Dienstpatroon gaat beschrijft het Ritpatroon de volgorde van punten waar wordt gestopt (de Geplande Stopplaatsen) met hun Doorkomsttijden. \n\nHet Ritpatroon is geassocieerd met de Route die ze volgt, meerdere Ritpatronen kunnen dezelfde Route volgen."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:0ce7e0b4dde22b6b1e6f9594e1c6f817e3bb978d4728900fb3dd3a8b7b5394c5"
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:8c3913372ee201620158b9842a20855927e2d5fec53b2a2be9bf8a0d3f0c50c4",
      "@type": "Class",
      "assignedURI": "https://purl.eu/ns/mobility/timetables-and-planning#PointInJourneyPattern",
      "vocLabel": [
        {
          "@language": "en",
          "@value": "Point in Journey Pattern"
        },
        {
          "@language": "nl",
          "@value": "Punt in Ritpatroon"
        }
      ],
      "diagramLabel": [
        {
          "@value": "PointInJourneyPattern"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Elk Punt in Ritpatroon specifieert het bezoek van een Dienst aan een specifiek Punt met een bepaalde volgorde binnen het patroon."
        },
        {
          "@language": "en",
          "@value": "Each Point in Journey Pattern specifies the visit of a Service to a specific Point in a particular order within the pattern."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:f9e1d77f2f95b0b71c826783ffe8b8cdcdbaec526465f8f22bbb85cf6a8ff6d2"
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:a16122b31ffa419a553b65b222873805efe0382a34b8e0d11516cac10c613911",
      "@type": "Class",
      "assignedURI": "https://purl.eu/ns/mobility/timetables-and-planning#TimeTabledPassingTime",
      "vocLabel": [
        {
          "@language": "en",
          "@value": "Time Tabled Passing Time"
        },
        {
          "@language": "nl",
          "@value": "Doorkomsttijd"
        }
      ],
      "diagramLabel": [
        {
          "@value": "TimeTabledPassingTime"
        }
      ],
      "vocDefinition": [
        {
          "@language": "en",
          "@value": "The PassingTimes that are the result of the scheduling process and to be published in a timetable are called TimeTabledPassingTimes. \n\nThe TimeTabledPassingTimes are normally generated a long time before the day of operation and are valid over a long period of time (e.g. summer, winter timetable)"
        },
        {
          "@language": "nl",
          "@value": "De Doorkomsttijden die het resultaat zijn van een planningsproces en gepubliceerd zullen worden in een dienstregeling worden Geplande Doorkomsttijden genoemd. \n\nDe Geplande Doorkomsttijden zijn normaliter een lange tijd voordat ze ingaan gepubliceerd en zijn geldig over een langere tijdspanne (bvb. zomer-, winterrooster)"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:6e2a0cc08370ba773443896a498a4f59fe6e184dfab2e3334426c0e1b58c7bee"
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:930cf81c57f281fd324e7afd0b9a4503a22d7d4ef5a061338ea9681b12961bd0",
      "@type": "Class",
      "assignedURI": "https://purl.eu/ns/mobility/timetables-and-planning#ScheduledStopPoint",
      "vocLabel": [
        {
          "@language": "en",
          "@value": "Scheduled Stop Point"
        },
        {
          "@language": "nl",
          "@value": "Gepland Stoppunt"
        }
      ],
      "diagramLabel": [
        {
          "@value": "ScheduledStopPoint"
        }
      ],
      "vocDefinition": [
        {
          "@language": "en",
          "@value": "A Point where passengers can board or alight from vehicles."
        },
        {
          "@language": "nl",
          "@value": "Een Punt waar passagiers kunnen op- of afstappen van voertuigen."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:f5689118ac2aa26a98904c5c3ad2a3be27a6619f955ec37078d26922169f6103"
        },
        {
          "@id": "urn:oslo-toolchain:4b11def7ef57d9e2947e0a8e9da508bc2f04076a6b4941c7be728eb9835f1a29"
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:f5689118ac2aa26a98904c5c3ad2a3be27a6619f955ec37078d26922169f6103",
      "@type": "Class",
      "assignedURI": "https://purl.eu/ns/mobility/timetables-and-planning#Point",
      "vocLabel": [
        {
          "@language": "en",
          "@value": "Point (Class)"
        },
        {
          "@language": "nl",
          "@value": "Punt (Klasse)"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Point"
        }
      ],
      "vocDefinition": [
        {
          "@language": "en",
          "@value": "A 0-dimensional node of the Network used for the spatial description of the Network. Points may be located by a Location in a given Locating System."
        },
        {
          "@language": "nl",
          "@value": "Een 0-dimensionale knoop van het netwerk gebruikt voor een ruimtelijke beschrijving van het Netwerk. De positie van een Punt wordt gegeven in een bepaald RuimtelijkReferentiesysteem."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage"
    },
    {
      "@id": "urn:oslo-toolchain:88a14425f6e75ae922a9b47862619494bbf0b0839da8a10215801909c67229ea",
      "@type": "Class",
      "assignedURI": "https://purl.eu/ns/mobility/timetables-and-planning#VehicleJourney",
      "vocLabel": [
        {
          "@language": "en",
          "@value": "Vehicle Journey"
        },
        {
          "@language": "nl",
          "@value": "Rit"
        }
      ],
      "diagramLabel": [
        {
          "@value": "VehicleJourney"
        }
      ],
      "vocDefinition": [
        {
          "@language": "en",
          "@value": "A VehicleJourney is the defined movement of a vehicle using a specified Journey Pattern on a particular Route. By virtue of being defined for a Day Type, a Vehicle Journey is a class of journeys that would take place at the same time on each day of a specified Day Type."
        },
        {
          "@language": "nl",
          "@value": "Een Rit is een vastgelegde beweging van een voertuig volgens een specifiek Ritpatroon op een bepaalde Route. Omdat ze gedefinieerd zijn voor een bepaald Dagtype (bv weekdag, schooldag, …), is “Rit” de klasse van Ritten die op dit Dagtype op hetzelfde tijdstip worden uitgevoerd."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:aa06bea9e5e078d36ce8ab1bf65c7d85c848d6eba415628e1db691dd47c7cb99"
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:7a690c9b054de3ae9c064547c71605934b35a1af856aab0bb902df17c13b8eb0",
      "@type": "Class",
      "assignedURI": "https://purl.eu/ns/mobility/timetables-and-planning#ServiceJourneyLink",
      "vocLabel": [
        {
          "@language": "en",
          "@value": "Service Journey Link"
        },
        {
          "@language": "nl",
          "@value": "Dienstritverbinding"
        }
      ],
      "diagramLabel": [
        {
          "@value": "ServiceJourneyLink"
        }
      ],
      "vocDefinition": [
        {
          "@language": "en",
          "@value": "The connection between two successive Scheduled Stop Points in a Service Journey. Since a Journey is always valid for a specific time (on a specific Day Type), each Service Journey Link has a specific departure and arrival time. Service Journey Links allow Route Planners to more easily calculate the shortest Routes."
        },
        {
          "@language": "nl",
          "@value": "De verbinding tussen twee opeenvolgende GeplandeStopplaatsen in een Dienstrit. Aangezien een Rit steeds geldt voor een bepaald tijdstip (op een bepaald Dagtype) heeft elke Dienstritverbinding een specifieke vertrek- en aankomsttijd. Dienstritverbindingen laten Routeplanners toe om makkelijker kortste Routes te berekenen."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage"
    },
    {
      "@id": "urn:oslo-toolchain:c2bb8679cabef9ce738c318d7612936298fc5c93163ba9daa1ebb35e1cabbcc9",
      "@type": "Class",
      "assignedURI": "https://purl.eu/ns/mobility/timetables-and-planning#PointOnRoute",
      "vocLabel": [
        {
          "@language": "en",
          "@value": "Point on Route"
        },
        {
          "@language": "nl",
          "@value": "Punt op route"
        }
      ],
      "diagramLabel": [
        {
          "@value": "PointOnRoute"
        }
      ],
      "vocDefinition": [
        {
          "@language": "en",
          "@value": "A Point on Route indicates the sequence of a Route Point within a Route. This intermediate object is required to allow a Route to go several times through the same RoutePoint."
        },
        {
          "@language": "nl",
          "@value": "Een Punt op Route geeft de volgorde van een Routepunt binnen een Route weer. Dit tussenliggende object is nodig om toe te laten dat een Route verschillende keren door eenzelfde Routepunt gaat."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:f9e1d77f2f95b0b71c826783ffe8b8cdcdbaec526465f8f22bbb85cf6a8ff6d2"
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:26b886b29b74347c969034e45b84a1bf7ddf41e916235d45a15c1fb4be334a2c",
      "@type": "Class",
      "assignedURI": "https://purl.eu/ns/mobility/timetables-and-planning#RoutePoint",
      "vocLabel": [
        {
          "@language": "en",
          "@value": "Route Point"
        },
        {
          "@language": "nl",
          "@value": "Routepunt"
        }
      ],
      "diagramLabel": [
        {
          "@value": "RoutePoint"
        }
      ],
      "vocDefinition": [
        {
          "@language": "en",
          "@value": "A Point used to define the shape of a Route through the Network. The same Point may be used in different Routes using a Point on Route."
        },
        {
          "@language": "nl",
          "@value": "Een Routepunt is een Punt dat wordt gebruikt om de vorm van een Route door een netwerk te definiëren. Hetzelfde PUNT kan worden gebruikt in verschillende Routes gebruik makend van een PuntOpRoute."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:f5689118ac2aa26a98904c5c3ad2a3be27a6619f955ec37078d26922169f6103"
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:262b86155e61756a0c2ab7a635f4913b37e2f2f4135b15eeb7969cbaf4ddac6b",
      "@type": "Class",
      "assignedURI": "https://purl.eu/ns/mobility/timetables-and-planning#RouteLink",
      "vocLabel": [
        {
          "@language": "en",
          "@value": "Route Link"
        },
        {
          "@language": "nl",
          "@value": "Routelink"
        }
      ],
      "diagramLabel": [
        {
          "@value": "RouteLink"
        }
      ],
      "vocDefinition": [
        {
          "@language": "en",
          "@value": "An oriented link between two Route Points allowing the definition of a unique path through the Network. The same Route Link may be used in different Routes."
        },
        {
          "@language": "nl",
          "@value": "Een Routelink is een georiënteerde link tussen twee Routepunten, welke toelaat om een uniek pad doorheen het netwerk te definiëren. Dezelfde Routelink kan worden gebruikt in verschillende Routes."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
