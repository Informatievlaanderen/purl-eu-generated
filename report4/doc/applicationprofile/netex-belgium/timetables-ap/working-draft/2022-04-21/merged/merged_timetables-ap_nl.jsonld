        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Informatie zoals email, telefoon, adres die toelaat om iemand of iets te contacteren."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Bvb een persoon of organisatie of dienstverlening... Mogelijke vormen van contact: bellen, mailen etc."
        },
        {
          "@language": "en",
          "@value": "Eg a person or organization or service... Possible forms of contact: calling, emailing, etc."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External"
    },
    {
      "@id": "urn:oslo-toolchain:ad2b73bfd6b898f9b802b0ab57933cb9cdd1008dfa49ad5c5e0b9226c68ffd4e",
      "@type": "Datatype",
      "assignedURI": "https://schema.org/QuantitativeValue",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Kwantitatieve Waarde"
        },
        {
          "@language": "en",
          "@value": "Quantitative Value"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Quantitative Value"
        }
      ],
      "vocDefinition": [
        {
          "@language": "en",
          "@value": "Indication of the quantity of a particular characteristic of an object."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Aanduiding van de kwantiteit van een bepaald kenmerk van een object."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Bvb de hoogte van een object,het gewicht,de temperatuur etc. Het gaat om een kenmerk dat numeriek uitgedrukt kan worden en in een bepaalde eenheid. Kwalitatieve aanduidingen zoals hoog,laag ed vallen hier dus niet onder."
        },
        {
          "@language": "en",
          "@value": "For example, the height of an object, the weight, the temperature, etc. It concerns a characteristic that can be expressed numerically and in a certain unit. Qualitative indications such as high, low, etc. are therefore not included."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External"
    },
    {
      "@id": "urn:oslo-toolchain:e95d66a651a2f0ea239f4fde6a4bd982bcca348a16bf0d9c84a99322185bf33a",
      "@type": "Datatype",
      "assignedURI": "http://www.opengis.net/ont/sf#LineString",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Lijnstring"
        },
        {
          "@language": "en",
          "@value": "Line String"
        }
      ],
      "diagramLabel": [
        {
          "@value": "LineString"
        }
      ],
      "vocDefinition": [
        {
          "@language": "en",
          "@value": "Curve with linear interpolation between the points. Each successive pair of points forms a line segment. The Line String has at least two points."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Curve met lineaire interpolatie tussen de punten. Elk opeenvolgend paar punten vormt een lijnsegment. De lijnstring heeft ten minste twee punten."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "Een curve is een 1-dimensioneel geometrisch object gedefinieerd als een sequentie van punten. De interpolatie kan op verschillende manieren gebeuren (bv lineair bij een lijnstring)."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:6ac7da3b1e6ee563c683bb20e6be52d1f1e5bc12fc4d6e050a106d4e74ea6997"
