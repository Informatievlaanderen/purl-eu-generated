    },
    {
      "@id": "urn:oslo-toolchain:52696805e671620e49407fd902970144ca11969b8c1667019271170e95b915a7",
      "@type": "Class",
      "assignedURI": "https://data.vlaanderen.be/ns/adres#Adres",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Adres"
        },
        {
          "@language": "en",
          "@value": "Address"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Address"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Informatie die toelaat om in België op een gestructureerde en unieke manier te verwijzen naar een \"gebouweenheid\", \"gebouw\", een “ligplaats”, een “standplaats” of een “perceel” op basis van de naam van de “gemeente, de “straatnaam” en het “huisnummer” eventueel aangevuld met een “busnummer” en met een “postcode”."
        }
      ],
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Informatie die toelaat om op een gestructureerde en unieke manier te verwijzen naar een gebouweenheid,een ligplaats,een standplaats of een perceel op basis van een gemeentenaam,een straatnaam,een huisnummer en eventueel een busnummer en een postcode."
        },
        {
          "@language": "en",
          "@value": "Information that makes it possible to refer in a structured and unique way to a building unit, a berth, a location or a plot on the basis of a municipality name, a street name, a house number and possibly a bus number and a postal code."
        }
      ],
      "apUsageNote": [
        {
          "@language": "nl",
          "@value": "De definitie heeft betrekking op Belgische adressen. In andere landen kan een adres eventueel verwijzen naar andere geografisch objecten (niet gebouweenheid of perceel) of bestaan uit andere aanduidingen (verschillend van huisnummer en busnummer) of uit andere componenten dan straatnaam, gemeentenaam of postcode. Alternatieve adresaanduidingen dan huisnummer of busnummer (bv ingangaanduiding, trapaanduiding, verdiepaanduiding...) of een gebouwnaam of kamernaam ed zijn mogelijk dmv een associatie met adresuitbreiding. Uitwisseling van buitenlandse adressen moet gebeuren mbv het object adresvoorstelling."
        },
        {
          "@language": "en",
          "@value": "The definition refers to Belgian Addresses. In other countries, an Address may refer to other geographical objects (not a building unit or parcel) or may consist of other designations (different from house number and bus number) or of components other than street name, municipality name or postal code. Foreign addresses can be exchanged using the Address Representation object. More detail on this class in the <a href=\"https://inspire.ec.europa.eu/id/document/tg/ad\">INSPRE Address specification</a>."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External"
    },
    {
      "@id": "urn:oslo-toolchain:85ae57ebcc5b4856841bcdc4babcdac7b1e1cf378d93146a45aa2bb9fa5dd2fb",
      "@type": "Class",
      "assignedURI": "https://purl.eu/ns/mobility/timetables-and-planning#GroupOfEntities",
      "vocLabel": [
        {
          "@language": "en",
          "@value": "Group of Entities"
        }
      ],
      "diagramLabel": [
        {
          "@value": "GroupOfEntities"
        }
      ],
      "vocDefinition": [
        {
          "@language": "en",
          "@value": "A set of Entities grouped together according to a purpose of grouping, e.g. grouping of stops known to the public by a common name."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage"
    },
    {
      "@id": "urn:oslo-toolchain:5b65ef38fd6cac6d5e54e67f811308225d5a2f5e5a53d48de1a87a921b4f30e8",
      "@type": "Class",
      "assignedURI": "https://purl.eu/ns/mobility/timetables-and-planning#LinkSequence",
      "vocLabel": [
        {
          "@language": "en",
          "@value": "Link Sequence"
        }
      ],
      "diagramLabel": [
        {
          "@value": "LinkSequence"
        }
      ],
      "vocDefinition": [
        {
          "@language": "en",
          "@value": "A Link Sequence describes a path through a Network, such as a bus route. It can consist of an ordered set of Points in Sequence (referencing Points of a particular type) or Links in Sequence (referencing Links of a particular type)."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage"
    },
    {
      "@id": "urn:oslo-toolchain:25b631bde45687655c882411ef5e826a906755fe482094196895abfe7ff20280",
