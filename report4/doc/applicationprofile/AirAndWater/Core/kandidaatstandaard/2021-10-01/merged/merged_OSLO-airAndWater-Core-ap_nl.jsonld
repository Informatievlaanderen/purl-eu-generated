        },
        {
          "@language": "nl",
          "@value": "Enter your translation here"
        }
      ],
      "apUsageNote": [
        {
          "@language": "en",
          "@value": "The procedure explains the steps to be carried out to arrive at reproducible results. It is reusable and might be involved in many Observations."
