        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "relatedObservation"
        },
        {
          "@language": "en",
          "@value": "relatedObservation"
        },
        {
          "@language": "nl",
          "@value": "relatedObservation"
        }
      ],
      "apUsageNote": [
        {
          "@language": "en",
          "@value": "It is about a relation that is important to understand the result of an individual Observation, eg a biotic relation (animal A is a predator and is present because animal B occurs as prey). Such relationships require to be explicitly described (as opposed to relationships as the coincidence of results of Observations in space and time, which are allowed to remain implicit). Also useful for relationships where the output of Observation A is the input for Observation B."
        },
        {
          "@language": "nl",
          "@value": "Enter your translation here"
        }
      ],
      "assignedURI": "http://def.isotc211.org/iso19156/2011/Observation#ObservationContext.relatedObservation",
      "diagramLabel": [
