      "apDefinition": [
        {
          "@language": "nl",
          "@value": "The resultTime describes the time when the result became available, typically when the procedure associated wit hthe observation was completed. For some observations this is identical to the phenomenonTime. Howevere there are important cases where they differ."
        },
        {
          "@language": "en",
          "@value": "Time when the result of the Observation was obtained."
        },
        {
          "@language": "nl",
