      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard",
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Sampling features are frequently related to each other, as parts of complexes, through sub-sampling, and in other ways. If present, the association class SamplingFeatureComplex shall link a SF_SamplingFeature to another SF_SamplingFeature. It shall support one attribute."
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "SamplingFeatureComplex"
        }
