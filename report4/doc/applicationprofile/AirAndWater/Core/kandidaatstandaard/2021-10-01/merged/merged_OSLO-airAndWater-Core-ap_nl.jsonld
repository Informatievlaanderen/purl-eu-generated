          "@language": "nl",
          "@value": "Enter your translation here"
        }
      ],
      "apUsageNote": [
        {
          "@language": "en",
          "@value": "SamplingFeatures are often related to each other, as parts of complexes, through subsampling ore in other ways. Eg SamplingPoints located along a SamplingCurve, Specimens obtained from the same SamplingPoint, pixels that are part of a scene, stations that form an array."
        },
        {
          "@language": "nl",
          "@value": "Enter your translation here"
        }
      ],
      "assignedURI": "http://def.isotc211.org/iso19156/2011/SamplingFeature#SamplingFeatureComplex",
