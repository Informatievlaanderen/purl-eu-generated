    {
      "@id": "urn:oslo-toolchain:8099096f24ae3664e60cf21699bf50cedfe7e2195458db5ddd8cb2a82ccfc93f",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "Some observations depend on other observations to provide context which is important, sometimes essential, in understanding the result. These dependencies are stronger than mere spatiotemporal coincidences, requiring explicit representation. If present, the association class ObservationContext (Figure 2) shall link an OM_Observation to another OM_Observation, with the role name relatedObservation for the target."
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "ObservationContext"
        }
      ],
      "assignedURI": "http://def.isotc211.org/iso19156/2011/Observation#ObservationContext",
      "diagramLabel": [
        {
          "@value": "ObservationContext"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard",
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Some observations depend on other observations to provide context which is important, sometimes essential, in understanding the result. These dependencies are stronger than mere spatiotemporal coincidences, requiring explicit representation. If present, the association class ObservationContext (Figure 2) shall link an OM_Observation to another OM_Observation, with the role name relatedObservation for the target."
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "ObservationContext"
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:d7daf5d8e091ec984f07674e0e0a03f5733937bf918f36cc9844fc2a4227495e",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "nl",
          "@value": "A workflow, protocol, plan, algorithm, or computational method specifying how to make an observation, create a sample, or make a change to the state of the world (via an actuator). A procedure is re-usable, and might be involved in many observations, samplings or actuations. It explains the steps to be carried out to arrived at reproducible results."
        }
      ],
      "apLabel": [
        {
          "@language": "nl",
          "@value": "ObservationProcedure"
