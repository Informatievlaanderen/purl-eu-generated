    {
      "@id": "urn:oslo-toolchain:44cff10145f0598a00f85aff0911071a7ca5b088832d6a84fb249b82381253c8",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "en",
          "@value": "Device, agent (including humans), or software (simulation) involved in, or implementing, a Procedure to make an Observation."
        },
        {
          "@language": "nl",
          "@value": "Enter your translation here"
        }
      ],
      "apLabel": [
        {
          "@language": "en",
          "@value": "Sensor"
        },
        {
          "@language": "nl",
          "@value": "Enter your translation here"
        }
      ],
      "apUsageNote": [
        {
          "@language": "en",
          "@value": "Sensors respond to a stimulus, eg a change in the environment, or Input data composed from the results of prior Observations, and generate a result. Sensors can be hosted by Platforms. Examples: accelerometers, gyroscopes, barameters, magnetometers etc, typically mounted on a smartphone (which acts as Platform). Other examples include the human eyes. For a more detailed description see the application profile ODALA Air & Water - Core."
        },
        {
          "@language": "nl",
          "@value": "Enter your translation here"
        }
      ],
      "assignedURI": "https://www.w3.org/TR/vocab-ssn/#SOSASensor",
      "diagramLabel": [
        {
          "@value": "Sensor"
        }
      ],
      "parent": [
        {
          "@id": "urn:oslo-toolchain:794dbdbac857cd93bd3f2f728a8e293393844926e4a216fbfcb4dd8461109248"
        },
        {
          "@id": "urn:oslo-toolchain:f58fe76dec669fd3970a7614e5df72f40d3d19874052b54da0b4e6e65dc40174"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard",
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Device, agent (including humans), or software (simulation) involved in, or implementing, a procedure. Sensors respond to a stimulus, e.e., a change in the environment, or Input data composed from the Results of prior observations, and generate a result. Sensors can be hosted by platforms."
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Sensor"
        }
      ]
    },
    {
      "@id": "urn:oslo-toolchain:faa9204e11f27dca1d8c4f89de1266c32922c02cc13008dc92533464030b6b98",
      "@type": "Class",
      "apDefinition": [
        {
          "@language": "en",
          "@value": "Part of the Object that one wants to observe and that is representative for that Object."
        },
        {
          "@language": "nl",
          "@value": "Enter your translation here"
        }
      ],
      "apLabel": [
        {
          "@language": "en",
          "@value": "SamplingFeature"
        },
        {
          "@language": "nl",
          "@value": "Enter your translation here"
        }
      ],
      "apUsageNote": [
        {
          "@language": "en",
          "@value": "This part can be physical (a Specimen) or spatial (a SpatialsamplingFeature). One observes a SamplingFeature instead of the actual Object if the latter cannot be observed as a whole (eg because exhaustive observation would be impractical). The SamplingFeature, together with the Process used for observation, forms the so-called observation protocol. ATTENTION: This class is abstract, it must be specialized in accordance with the application domain. For a more detailed description see the application profile ODALA Air & Water -Core."
        },
        {
          "@language": "nl",
          "@value": "Enter your translation here"
        }
      ],
      "assignedURI": "http://def.isotc211.org/iso19156/2011/SamplingFeature#SF_SamplingFeature",
      "diagramLabel": [
        {
          "@value": "SamplingFeature"
        }
      ],
      "parent": [
        {
          "@id": "urn:oslo-toolchain:d0d10ad5b42e6ac50c4576ccdf947be1137c634ac3f857d2009dd5281366198a"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard",
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Feature, such as a station, transect, section or specimen, which is involved in making observations concerning a domain feature"
        }
      ],
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "SamplingFeature"
        }
      ]
