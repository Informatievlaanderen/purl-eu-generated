      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Observation that assesses the biological Quality of Water based on the overall condition of indicator species."
        }
      ],
      "apDefinition": [
        {
          "@language": "en",
          "@value": "Observation that assesses the biological Quality of Water based on the overall condition of indicator species."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "These species, also called BioIndicators, are living organisms such as plants, planktons, animals, microbes etc. More specifically, biochemical, physiological, behavioural or population changes are monitored."
        }
      ],
      "apUsageNote": [
        {
          "@language": "en",
