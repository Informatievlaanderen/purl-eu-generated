          "@language": "nl",
          "@value": "TM_Object is a temporal object."
        }
      ],
      "apDefinition": [
        {
          "@language": "en",
          "@value": "Abstract temporal class."
        }
      ],
      "apUsageNote": [
        {
          "@language": "en",
          "@value": "In practice, usually takes the form of temporal primitives like Moment or Period (resp represented by a Date/DateTime or two Dates/DateTimes, one for the beginning of the Period, one for the end of the Period). For a more detailed description of this class see ISO 19108."
        }
