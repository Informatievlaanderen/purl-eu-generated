        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:faa9204e11f27dca1d8c4f89de1266c32922c02cc13008dc92533464030b6b98",
      "@type": "Class",
      "assignedURI": "http://def.isotc211.org/iso19156/2011/SamplingFeature#SF_SamplingFeature",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "SamplingFeature"
        }
      ],
      "apLabel": [
        {
          "@language": "en",
          "@value": "SamplingFeature"
        }
      ],
      "diagramLabel": [
        {
          "@value": "SamplingFeature"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Feature, such as a station, transect, section or specimen, which is involved in making observations concerning a domain feature"
        }
      ],
      "apDefinition": [
        {
          "@language": "en",
          "@value": "Part of the Object that one wants to observe and that is representative for that Object."
        }
      ],
      "apUsageNote": [
        {
          "@language": "en",
          "@value": "This part can be physical (a Specimen) or spatial (a SpatialsamplingFeature). One observes a SamplingFeature instead of the actual Object if the latter cannot be observed as a whole (eg because exhaustive observation would be impractical). The SamplingFeature, together with the Process used for observation, forms the so-called observation protocol. ATTENTION: This class is abstract, it must be specialized in accordance with the application domain. For a more detailed description see the application profile ODALA Air & Water -Core."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
