          "@value": "The class NamedValue provides for a generic soft-typed parameter value."
        }
      ],
      "apDefinition": [
        {
          "@language": "en",
          "@value": "Generic soft-typed value."
        }
      ],
      "apUsageNote": [
        {
          "@language": "en",
          "@value": "Essentially a value and the type of the value, given by a name. For example 21degrees temperature (value=21degrees, name=temperature). For a more detailed description of this class see ISO 19156."
        }
      ],
