      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Indication of the quantity of a particular characteristic of an Object."
        }
      ],
      "apDefinition": [
        {
          "@language": "en",
          "@value": "Indication of the quantity of a particular characteristic of an Object."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "For example, the height of an Object, the weight, the temperature etc. It applies to some property that can be expressed numerically and in a specific unit of measure. Qualitative indications of value like high, low etc. are therefore not included."
        }
      ],
      "apUsageNote": [
        {
          "@language": "en",
          "@value": "For example, the height of an Object, the weight, the temperature etc. It applies to some property that can be expressed numerically and in a specific unit of measure. Qualitative indications of value like high, low etc. are therefore not included."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
